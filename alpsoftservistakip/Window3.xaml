<Window x:Class="alpsoftservistakip.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:alpsoftservistakip.Controls"
        
        mc:Ignorable="d"
        Title="AlpSoft Servis Takip v1.6.2" 
        ResizeMode="CanResize" 
        WindowState="Maximized" 
        WindowStartupLocation="CenterScreen"
        MinHeight="720"
        MinWidth="1080" Closing="Window_Closing">

    <Viewbox Stretch="Uniform">
        <Grid HorizontalAlignment="Center" Width="1920" Height="1080" VerticalAlignment="Center">

            <Rectangle Margin="-154,-347,-480,-86" Fill="#FF252B36" Panel.ZIndex="10" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <TransformGroup>
                        <SkewTransform AngleX="-0.065"/>
                        <TranslateTransform X="-0.999"/>
                    </TransformGroup>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle HorizontalAlignment="Left" Margin="36,36,0,36" Width="1839" Fill="#FFF5C721" Panel.ZIndex="10"/>

            <Image Source="/Alpsoftlogotransparan.png" Width="1179" Height="1118" HorizontalAlignment="Left" VerticalAlignment="Top" 
                   RenderTransformOrigin="0.467,0.62" Panel.ZIndex="11" Margin="375,-347,0,0"/>

            <UniformGrid Columns="5" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="100,582,0,0" Panel.ZIndex="14" Width="1700">
                <Button x:Name="kayitlar" Content="KAYITLAR" FontSize="22" Foreground="White" Background="#FF252B36" Width="310" Height="82" Click="kayitlar_Click" FontFamily="Arial Black" Cursor="Hand">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Button.RenderTransform>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF252B36"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1.1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1.1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="kayitolustur" Content="KAYIT OLUŞTUR" FontSize="22" Foreground="White" Background="#FF252B36" Width="310" Height="82" Click="kayitolustur_Click" FontFamily="Arial Black" Cursor="Hand">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Button.RenderTransform>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF252B36"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1.1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1.1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="btnAdminPanelAc" Content="ADMİN PANELİ" FontSize="22" Foreground="#FF252B36" Background="White" Width="310" Height="82" Click="btnAdminPanelAc_Click" FontFamily="Arial Black" Cursor="Hand">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Button.RenderTransform>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="White"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1.1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1.1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="disserviskayitlari" Content="DIŞ SERVİS" FontSize="22" Foreground="White" Background="#FF252B36" Width="310" Height="82" Click="disserviskayitlari_Click" FontFamily="Arial Black" Cursor="Hand">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Button.RenderTransform>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF252B36"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1.1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1.1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="disserviskayitlari_Copy" Content="KAYITLAR" FontSize="22" Foreground="White" Background="#FF252B36" Width="310" Height="82" Click="disserviskayitlari_Copy_Click" FontFamily="Arial Black" Cursor="Hand">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Button.RenderTransform>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF252B36"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1.1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1.1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </UniformGrid>

            <Grid x:Name="AdminPanelTabakasi" Panel.ZIndex="50" Visibility="Collapsed">
                <Rectangle Fill="Black" Opacity="0.7"/>
                <Border Background="#FF252B36" Width="1400" Height="880" CornerRadius="30" BorderBrush="#FFF5C721" BorderThickness="4">
                    <Grid Margin="40">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <TextBlock Text="EKİP VE LİSANS YÖNETİMİ" Foreground="#FFF5C721" FontSize="42" FontFamily="Arial Black"/>
                            <Button Content="KAPAT [X]" HorizontalAlignment="Right" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="20" Click="AdminPanelKapat_Click" Cursor="Hand"/>
                        </DockPanel>

                        <StackPanel Grid.Row="1" Margin="0,30">
                            <TextBlock x:Name="txtLisansDurum" Text="Lisans Kullanımı: 1 / 3" Foreground="White" FontSize="22" Margin="0,0,0,10"/>
                            <ProgressBar x:Name="pbLisans" Value="33" Height="20" Background="#FF1A1F26" Foreground="#FFF5C721" BorderThickness="0"/>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="420"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" Margin="0,0,30,0" CornerRadius="15" ClipToBounds="True">
                                <DataGrid x:Name="dgIsciler" AutoGenerateColumns="False" CanUserAddRows="False" 
                                          Background="Transparent" BorderThickness="0" RowHeight="55" FontSize="18" VerticalContentAlignment="Center">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}" Width="*"/>
                                        <DataGridTextColumn Header="E-Posta" Binding="{Binding Email}" Width="*"/>
                                        <DataGridTextColumn Header="Rol" Binding="{Binding Role}" Width="100"/>
                                        <DataGridTemplateColumn Header="İşlemler" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="SİL" Background="#FFEE2E2E" Foreground="White" FontWeight="Bold" 
                                                            Click="IsciSil_Click" Tag="{Binding Email}" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="5"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <TextBlock Text="YENİ İŞÇİ KAYDI" Foreground="White" FontSize="22" Margin="0,0,0,20" FontFamily="Arial Black"/>

                                <TextBlock Text="Ad Soyad:" Foreground="#FFF5C721" Margin="0,5"/>
                                <TextBox x:Name="txtYeniAd" Height="45" FontSize="18" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                                <TextBlock Text="E-Posta:" Foreground="#FFF5C721" Margin="0,5"/>
                                <TextBox x:Name="txtYeniEmail" Height="45" FontSize="18" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                                <TextBlock Text="Giriş Şifresi:" Foreground="#FFF5C721" Margin="0,5"/>
                                <TextBox x:Name="txtYeniSifre" Height="45" FontSize="18" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                                <Button Content="İşçiyi Kaydet" Height="60" Margin="0,20" Background="#FFF5C721" Foreground="#FF252B36" 
                                        Click="IsciKaydet_Click" FontFamily="Arial Black" FontSize="20">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="10"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <TextBlock Text="* Maksimum işçi limitine ulaştığınızda bu alan pasif olur." Foreground="White" Opacity="0.6" FontSize="14" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Text="© 2024 Alpsoft - Servis Takip Sistemi" FontSize="20" Foreground="Black" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1001,0,0" Panel.ZIndex="20"/>

            <!-- Overlay frame to show pages smoothly -->
            <!-- Semi-transparent backdrop when showing overlay -->
            <Rectangle x:Name="OverlayBackdrop" Fill="Black" Opacity="0" Visibility="Collapsed" Panel.ZIndex="998" 
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                       Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" 
                       Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"/>
            <Frame x:Name="OverlayFrame" NavigationUIVisibility="Hidden" Visibility="Collapsed" Background="Transparent" Panel.ZIndex="999"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Label Content="OLCAY" HorizontalAlignment="Left" Margin="880,907,0,0" VerticalAlignment="Top" Panel.ZIndex="40" FontSize="24"/>

        </Grid>
    </Viewbox>
</Window>