<Window x:Class="alpsoftservistakip.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:alpsoftservistakip.Controls"
        mc:Ignorable="d"
        Title="ALPSOFT | Servis Yönetim Platformu" 
        WindowStyle="None"
        ResizeMode="CanResize" 
        WindowState="Maximized" 
        WindowStartupLocation="CenterScreen"
        MinHeight="580"
        MinWidth="900" Closing="Window_Closing" StateChanged="Window3_StateChanged"
        Background="#181A20"
        BorderBrush="#181A20"
        BorderThickness="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" 
                      ResizeBorderThickness="6" 
                      GlassFrameThickness="0" 
                      CornerRadius="0" 
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0,0,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Margin="10,2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#21252D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="Background" Value="#171A21"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Main Button Style (Quick Access) -->
        <Style x:Key="MainButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Background" Value="#121418"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A2E35"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderBrush}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#21252D"/>
                                <Setter Property="Foreground" Value="#FFD026"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFD026"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="Background" Value="#0F1114"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform ScaleX="1" ScaleY="1" />
                <TranslateTransform Y="0" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Title Bar -->
        <Border Grid.Row="0" Background="#121418" MouseDown="Window_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Top Left Logo Area -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <Border Background="#FFD026" Width="24" Height="24" CornerRadius="6" Margin="0,0,10,0">
                        <TextBlock Text="A" Foreground="#121418" FontWeight="Black" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ALPSOFT" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text=" SERVİS YÖNETİM PLATFORMU" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,2,0,0"/>
                </StackPanel>

                <!-- Top Center Active Badge -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0C1B18" BorderBrush="#143329" BorderThickness="1" CornerRadius="12" Padding="15,4">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="SİSTEM AKTİF" Foreground="#10B981" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Top Right Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Width="40" Height="30" Background="Transparent" BorderThickness="0" Foreground="#ADB5BD" Click="btnMinimize_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#21252D"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button Width="40" Height="30" Background="Transparent" BorderThickness="0" Foreground="#ADB5BD" Click="btnMaximize_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#21252D"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="txtMaximizeIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button Width="40" Height="30" Background="Transparent" BorderThickness="0" Foreground="#ADB5BD" Click="btnClose_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#121418">
                <Grid>
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="MENÜ" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="20,0,0,10"/>
                        
                        <Button Style="{StaticResource SidebarButtonStyle}" Click="kayitlar_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE14C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="#3B82F6"/>
                                <TextBlock Text="Kayıtlar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButtonStyle}" Click="kayitolustur_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="#10B981"/>
                                <TextBlock Text="Kayıt Oluştur" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnAdminPanelAc" Style="{StaticResource SidebarButtonStyle}" Click="btnAdminPanelAc_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="#F59E0B"/>
                                <TextBlock Text="Admin Paneli" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButtonStyle}" Click="disserviskayitlari_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="#8B5CF6"/>
                                <TextBlock Text="Dış Servisler" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButtonStyle}" Click="caritakip_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="#06B6D4"/>
                                <TextBlock Text="Cari Takip" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButtonStyle}" Click="btnToptanciYonetimi_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="#F97316"/>
                                <TextBlock Text="Toptancı" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButtonStyle}" Click="btnStokTakibi_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B1;" FontFamily="Segoe MDL2 Assets" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="#10B981"/>
                                <TextBlock Text="Stok Takibi" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButtonStyle}" Click="btnSatisGecmisi_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="#EC4899"/>
                                <TextBlock Text="Satış Geçmişi" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <TextBlock Text="v1.0.0 Stable" Foreground="#64748B" FontSize="11" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                </Grid>
            </Border>

            <!-- Center View -->
            <Grid Grid.Column="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Background="#FFD026" Width="80" Height="80" CornerRadius="20" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock Text="A" Foreground="#121418" FontWeight="Black" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <TextBlock Text="ALPSOFT" Foreground="#FFFFFF" FontSize="32" FontWeight="Black" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                    <TextBlock Text="Servis Yönetim Platformu" Foreground="#FFD026" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,40"/>
                    
                    <Border Background="#121418" CornerRadius="12" BorderBrush="#2A2E35" BorderThickness="1" Width="420" Padding="15" Margin="0,0,0,30">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE11A;" FontFamily="Segoe MDL2 Assets" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Sol menüden bir işlem seçin" Foreground="#CBD5E1" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource MainButtonStyle}" Click="kayitlar_Click" Margin="0,0,15,0">
                            <StackPanel>
                                <TextBlock Text="&#xE14C;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Kayıtlar" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MainButtonStyle}" Click="caritakip_Click" Margin="0,0,15,0">
                            <StackPanel>
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Cari Takip" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MainButtonStyle}" Click="btnStokTakibi_Click" Margin="0,0,15,0">
                            <StackPanel>
                                <TextBlock Text="&#xE8B1;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Stok Takibi" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MainButtonStyle}" Click="btnSatisGecmisi_Click" Margin="0,0,15,0">
                            <StackPanel>
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Satışlar" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MainButtonStyle}" Click="disserviskayitlari_Click">
                            <StackPanel>
                                <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Dış Servisler" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- The overlay host for dynamically loaded pages -->
                <local:OverlayHost x:Name="OverlayHost" Panel.ZIndex="100"/>
            </Grid>
        </Grid>


        <!-- Stok Kilit Tabakası (Premium Lock) -->
        <Grid x:Name="StokKilitTabakasi" Visibility="Collapsed" Panel.ZIndex="201" Background="#EA000000">
            <Border Width="450" Height="340" Background="#181A20" BorderThickness="1" BorderBrush="#3F4452" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.4" Color="Black"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="#FFF5C721" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="Stok Modülü Kilitli" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="Bu modülü kullanabilmek için geçerli bir lisans anahtarı girmelisiniz. Lisans satın almak için destek ekibiyle iletişime geçin." 
                               Foreground="#A0A5B1" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,25" Width="360"/>
                    
                    <TextBox x:Name="txtStokKodu" Width="360" Height="45" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" Background="#252932" Foreground="#FFF5C721" BorderBrush="#3F4452" BorderThickness="1.5" Margin="0,0,0,20">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="btnStokIptal" Content="KAPAT" Click="btnStokIptal_Click" Width="140" Height="42" Background="#252932" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" Cursor="Hand" Margin="0,0,15,0" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="btnStokAktiflestir" Content="KİLİDİ AÇ" Click="btnStokAktiflestir_Click" Width="140" Height="42" Background="#FFF5C721" Foreground="#121418" FontSize="14" FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        
    </Grid>
</Window>
