<Window x:Class="alpsoftservistakip.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:alpsoftservistakip.Controls"
        
        mc:Ignorable="d"
        Title="ALPSOFT | Servis Yönetim Platformu" 
        WindowStyle="None"
        ResizeMode="CanResize" 
        WindowState="Maximized" 
        WindowStartupLocation="CenterScreen"
        MinHeight="720"
        MinWidth="1080" Closing="Window_Closing" StateChanged="Window3_StateChanged">

    <Window.Resources>
        <LinearGradientBrush x:Key="TitleBarBg" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0B1220" Offset="0"/>
            <GradientStop Color="#111827" Offset="0.5"/>
            <GradientStop Color="#0F172A" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TitleBarBorder" Color="#1E293B"/>
        <SolidColorBrush x:Key="TitleBarButtonFg" Color="#CBD5E1"/>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TitleBarButtonFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <Grid HorizontalAlignment="Center" Width="1920" Height="1080" VerticalAlignment="Center" Background="#FFF5C721">

            <Border Panel.ZIndex="200" Background="{StaticResource TitleBarBg}" BorderBrush="{StaticResource TitleBarBorder}" BorderThickness="0,0,0,1" Height="52" VerticalAlignment="Top" MouseDown="Window_MouseDown">
                <Grid Margin="14,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                        <Border Width="26" Height="26" CornerRadius="13" Background="#2563EB" Margin="0,0,10,0">
                            <TextBlock Text="A" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="ALPSOFT SERVİS YÖNETİM PLATFORMU" Foreground="White" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="Kurumsal Servis Takip Sistemi" Foreground="#94A3B8" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12,4" CornerRadius="12" Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                        <TextBlock Text="SİSTEM AKTİF" Foreground="#93C5FD" FontSize="10" FontWeight="SemiBold"/>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="btnMinimize_Click" Margin="0,0,4,0">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="btnMaximize_Click" Margin="0,0,4,0">
                            <TextBlock x:Name="txtMaximizeIcon" Text="&#xE923;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseButtonStyle}" Click="btnClose_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Rectangle Panel.ZIndex="199" Height="1" VerticalAlignment="Top" Margin="0,52,0,0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2563EB" Offset="0"/>
                        <GradientStop Color="#06B6D4" Offset="0.5"/>
                        <GradientStop Color="#22C55E" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle HorizontalAlignment="Left" Margin="36,36,0,236" Width="1839" Fill="#FFF5C721" Panel.ZIndex="10"/>

            <Image Source="/Alpsoftlogotransparan.png" Width="1179" Height="1118" HorizontalAlignment="Left" VerticalAlignment="Top" 
                   RenderTransformOrigin="0.467,0.62" Panel.ZIndex="11" Margin="367,-195,0,0"/>

            <!-- Button container grid centered with 7 columns as requested replacing old properties -->
            <UniformGrid Columns="7" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,582,0,0" Panel.ZIndex="14" Width="1600">
                <Button x:Name="kayitlar" Content="KAYITLAR" FontSize="18" Foreground="White" Background="#1E293B" Height="100" Margin="10,0" Click="kayitlar_Click" FontFamily="Arial Black" Cursor="Hand">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Button.RenderTransform>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20" BorderBrush="#334155" BorderThickness="2" Padding="15">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3B82F6"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="kayitolustur" Content="KAYIT OLUŞTUR" FontSize="18" Foreground="White" Background="#1E293B" Height="100" Margin="10,0" Click="kayitolustur_Click" FontFamily="Arial Black" Cursor="Hand">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Button.RenderTransform>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20" BorderBrush="#334155" BorderThickness="2" Padding="15">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#10B981"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="btnAdminPanelAc" Content="ADMİN PANELİ" FontSize="18" Foreground="White" Background="#1E293B" Height="100" Margin="10,0" Click="btnAdminPanelAc_Click" FontFamily="Arial Black" Cursor="Hand">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Button.RenderTransform>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20" BorderBrush="#334155" BorderThickness="2" Padding="15">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F59E0B"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="disserviskayitlari_Copy" Content="DIŞ SERVİSLER" FontSize="18" Foreground="White" Background="#1E293B" Height="100" Margin="10,0" Click="disserviskayitlari_Copy_Click" FontFamily="Arial Black" Cursor="Hand">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Button.RenderTransform>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20" BorderBrush="#334155" BorderThickness="2" Padding="15">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#8B5CF6"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="btnCariTakip" Content="CARİ TAKİP" FontSize="18" Foreground="White" Background="#1E293B" Height="100" Margin="10,0" Click="caritakip_Click" FontFamily="Arial Black" Cursor="Hand">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Button.RenderTransform>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20" BorderBrush="#334155" BorderThickness="2" Padding="15">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#06B6D4"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="btnToptanciYonetimi" Content="TOPTANCI" FontSize="18" Foreground="White" Background="#1E293B" Height="100" Margin="10,0" Click="btnToptanciYonetimi_Click" FontFamily="Arial Black" Cursor="Hand">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Button.RenderTransform>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20" BorderBrush="#334155" BorderThickness="2" Padding="15">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EC4899"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="btnStokTakibi" Content="STOK TAKİBİ" FontSize="18" Foreground="White" Background="#1E293B" Height="100" Margin="10,0" Click="btnStokTakibi_Click" FontFamily="Arial Black" Cursor="Hand">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Button.RenderTransform>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="20" BorderBrush="#334155" BorderThickness="2" Padding="15">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E74C3C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </UniformGrid>

            <Grid x:Name="StokKilitTabakasi" Panel.ZIndex="51" Visibility="Collapsed">
                <Rectangle Fill="Black" Opacity="0.7"/>
                <Border Background="White" Width="500" Height="280" CornerRadius="20" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" Color="#000" Opacity="0.5" ShadowDepth="10"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🔒 STOK TAKİBİ KİLİTLİ" FontSize="22" FontWeight="Bold" Foreground="#E74C3C" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Bu özelliği kullanabilmek için aktivasyon kodu gereklidir." Foreground="#555" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,20"/>

                        <TextBox x:Name="txtStokKodu" Height="45" FontSize="18" Padding="10,0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="2" Margin="0,0,0,20" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="İPTAL" Background="#E2E8F0" Foreground="#334155" Height="45" FontWeight="Bold" Cursor="Hand" Click="btnStokIptal_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                            </Button>
                            <Button Grid.Column="2" Content="AKTİFLEŞTİR" Background="#3B82F6" Foreground="White" Height="45" FontWeight="Bold" Cursor="Hand" Click="btnStokAktiflestir_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="AdminPanelTabakasi" Panel.ZIndex="50" Visibility="Collapsed">
                <Rectangle Fill="Black" Opacity="0.7"/>
                <Border Background="#FF252B36" Width="1400" Height="880" CornerRadius="30" BorderBrush="#FFF5C721" BorderThickness="4">
                    <Grid Margin="40">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <TextBlock Text="EKİP VE LİSANS YÖNETİMİ" Foreground="#FFF5C721" FontSize="42" FontFamily="Arial Black"/>
                            <Button Content="KAPAT [X]" HorizontalAlignment="Right" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="20" Click="AdminPanelKapat_Click" Cursor="Hand"/>
                        </DockPanel>

                        <StackPanel Grid.Row="1" Margin="0,30">
                            <TextBlock x:Name="txtLisansDurum" Text="Lisans Kullanımı: 1 / 3" Foreground="White" FontSize="22" Margin="0,0,0,10"/>
                            <ProgressBar x:Name="pbLisans" Value="33" Height="20" Background="#FF1A1F26" Foreground="#FFF5C721" BorderThickness="0"/>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="420"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" Margin="0,0,30,0" CornerRadius="15" ClipToBounds="True">
                                <DataGrid x:Name="dgIsciler" AutoGenerateColumns="False" CanUserAddRows="False" 
                                          Background="Transparent" BorderThickness="0" RowHeight="55" FontSize="18" VerticalContentAlignment="Center">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}" Width="*"/>
                                        <DataGridTextColumn Header="E-Posta" Binding="{Binding Email}" Width="*"/>
                                        <DataGridTextColumn Header="Rol" Binding="{Binding Role}" Width="100"/>
                                        <DataGridTemplateColumn Header="İşlemler" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="SİL" Background="#FFEE2E2E" Foreground="White" FontWeight="Bold" 
                                                            Click="IsciSil_Click" Tag="{Binding Email}" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="5"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <TextBlock Text="YENİ İŞÇİ KAYDI" Foreground="White" FontSize="22" Margin="0,0,0,20" FontFamily="Arial Black"/>

                                <TextBlock Text="Ad Soyad:" Foreground="#FFF5C721" Margin="0,5"/>
                                <TextBox x:Name="txtYeniAd" Height="45" FontSize="18" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                                <TextBlock Text="E-Posta:" Foreground="#FFF5C721" Margin="0,5"/>
                                <TextBox x:Name="txtYeniEmail" Height="45" FontSize="18" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                                <TextBlock Text="Giriş Şifresi:" Foreground="#FFF5C721" Margin="0,5"/>
                                <TextBox x:Name="txtYeniSifre" Height="45" FontSize="18" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                                <Button Content="İşçiyi Kaydet" Height="60" Margin="0,20" Background="#FFF5C721" Foreground="#FF252B36" 
                                        Click="IsciKaydet_Click" FontFamily="Arial Black" FontSize="20">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="10"/>
                                        </Style>
