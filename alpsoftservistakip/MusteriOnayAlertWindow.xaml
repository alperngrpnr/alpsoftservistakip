<Window x:Class="alpsoftservistakip.MusteriOnayAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Müşteri Fiyat Kararı" 
        Height="220" Width="380"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    
    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="30" To="0" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>

    <Border Margin="10" CornerRadius="16" BorderThickness="1.5" x:Name="borderMain"
            Background="#0F172A" BorderBrush="#10B981">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="6" Opacity="0.7"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform Y="0"/>
        </Border.RenderTransform>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="36" Height="36" CornerRadius="10" x:Name="bdIcon"
                        Background="#064E3B" BorderBrush="#059669" BorderThickness="1" Margin="0,0,10,0">
                    <TextBlock x:Name="txtIcon" Text="🎉" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="txtBaslik" Text="MÜŞTERİ FİYAT ONAYI VERDİ!" 
                               FontSize="13" FontWeight="ExtraBold" Foreground="#10B981"/>
                    <TextBlock x:Name="txtAltBaslik" Text="Onarım işlemine başlanabilir" 
                               FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>

                <Button Grid.Column="2" Content="✕" Width="26" Height="26" 
                        Background="Transparent" BorderThickness="0" Foreground="#64748B" 
                        FontSize="12" Cursor="Hand" Click="BtnKapat_Click"/>
            </Grid>

            <!-- Body -->
            <Border Grid.Row="1" Background="#1E293B" CornerRadius="10" Padding="12,8" Margin="0,0,0,10">
                <StackPanel VerticalAlignment="Center">
                    <Grid Margin="0,1">
                        <TextBlock Text="Servis No:" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="txtServisNo" Text="SRV-000000" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,1">
                        <TextBlock Text="Müşteri:" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="txtMusteri" Text="Değerli Müşterimiz" FontSize="11" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,1">
                        <TextBlock Text="Cihaz:" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="txtCihaz" Text="iPhone 13" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,1">
                        <TextBlock Text="Tutar:" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="txtTutar" Text="0,00 TL" FontSize="12" FontWeight="ExtraBold" Foreground="#FFD026" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Footer / Action -->
            <Button Grid.Row="2" Content="✅ Tamam (Anlaşıldı)" Height="34" 
                    Background="#10B981" Foreground="#0F172A" FontWeight="Bold" FontSize="12"
                    BorderThickness="0" Cursor="Hand" Click="BtnKapat_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>
