<Page x:Name="disserviskayıtolusturma" x:Class="alpsoftservistakip.Page6"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:alpsoftservistakip.Controls"
        mc:Ignorable="d">

    <Grid Background="#FF252B36" HorizontalAlignment="Center" Width="852" Height="490" VerticalAlignment="Top">
        <GroupBox Header="DIŞ SERVİS KAYIT BİLGİLERİ"
            FontFamily="Segoe UI Black" FontWeight="Bold"
            FontStyle="Italic" FontSize="16" BorderBrush="#FF252B36" Margin="0,0,0,152" HorizontalAlignment="Center" Width="832" Height="328" VerticalAlignment="Bottom" Foreground="White"/>
        <Border x:Name="bayiadidiservisborder"
            CornerRadius="10" Background="White"
            BorderBrush="#2E2E2E" BorderThickness="1"
            Padding="8" Margin="546,153,0,0" HorizontalAlignment="Left" Width="278" Height="58" VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.35"/>
            </Border.Effect>
            <TextBox x:Name="bayiadidisservis"
                Text="Yetkili Bayi Adı*"
                GotFocus="bayiadidisservis_GotFocus"
                LostFocus="bayiadidisservis_LostFocus"
                Background="White" BorderThickness="0"
                Foreground="#FF848484" FontSize="14"
                VerticalContentAlignment="Center" Padding="5"/>
        </Border>
        <Border x:Name="ilgiliteknisyendisservisborder"
            CornerRadius="10" Background="White"
            BorderBrush="#2E2E2E" BorderThickness="1"
            Padding="8" HorizontalAlignment="Left" Width="278" Height="58" VerticalAlignment="Center" Margin="546,0,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.35"/>
            </Border.Effect>
            <TextBox x:Name="ilgiliteknisyendisservis"
                Text="İlgili Teknisyen"
                GotFocus="ilgiliteknisyendisservis_GotFocus"
                LostFocus="ilgiliteknisyendisservis_LostFocus"
                Background="White" BorderThickness="0"
                Foreground="#FF848484" FontSize="14"
                VerticalContentAlignment="Center" Padding="5"/>
        </Border>
        <Button x:Name="disserviskaydinikaydet" Content="KAYDET"
            FontSize="24"
            Foreground="White"
            Background="Red"
            BorderThickness="0"
            Cursor="Hand" 
            FontFamily="Arial Black" RenderTransformOrigin="0.5,0" Panel.ZIndex="5" Click="disserviskaydinikaydet_Click" Margin="48,0,0,42" HorizontalAlignment="Left" Width="239" Height="60" VerticalAlignment="Bottom">
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}"
                                    CornerRadius="15"
                                    SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black"
                                            BlurRadius="30"
                                            ShadowDepth="5"
                                            Opacity="0.4"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>

                    <!-- Fare üstüne gelince sadece zoom efekti -->
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="Red"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                            To="1.08" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                            To="1.08" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                            To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                            To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Button x:Name="disserviskaydigeridön" Content="GERİ DÖN"
            FontSize="24"
            Foreground="White"
            Background="#FFF5C721"
            BorderThickness="0"
            Cursor="Hand" 
            FontFamily="Arial Black" RenderTransformOrigin="0.5,0" Panel.ZIndex="5"  Margin="0,0,48,42" Height="60" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="239" Click="disserviskaydigeridön_Click">
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}"
                                    CornerRadius="15"
                                    SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black"
                                            BlurRadius="15"
                                            ShadowDepth="3"
                                            Opacity="0.4"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>

                    <!-- Fare üstüne gelince sadece zoom efekti -->
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFF5C721"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                            To="1.08" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                            To="1.08" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                            To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                            To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Border x:Name="adsoyadborder"
            CornerRadius="10" Background="White"
            BorderBrush="#2E2E2E" BorderThickness="1"
            Padding="8" HorizontalAlignment="Left" Width="278" Height="58" VerticalAlignment="Top" Margin="48,44,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.35"/>
            </Border.Effect>
            <TextBox x:Name="isimsoyisimdisservis"
                Text="Ad Soyad"
                GotFocus="isimsoyisimdisservis_GotFocus"
                LostFocus="isimsoyisimdisservis_LostFocus"
                Background="White" BorderThickness="0"
                Foreground="#FF848484" FontSize="14"
                VerticalContentAlignment="Center" Padding="5"/>
        </Border>
        <Border x:Name="telefonnumarasıdisservisborder"
            CornerRadius="10" Background="White"
            BorderBrush="#2E2E2E" BorderThickness="1"
            Padding="8" HorizontalAlignment="Left" Width="278" Height="58" VerticalAlignment="Top" Margin="48,107,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.35"/>
            </Border.Effect>
            <TextBox x:Name="telefonnumarasidisservis"
                Text="Cep Telefonu"
                     TextChanged="telefonnumarasidisservis_TextChanged"
                GotFocus="telefonnumarasidisservis_GotFocus"
                LostFocus="telefonnumarasidisservis_LostFocus"
                Background="White" BorderThickness="0"
                Foreground="#FF848484" FontSize="14"
                VerticalContentAlignment="Center" Padding="5"/>
        </Border>
        <Border x:Name="markadisservisborder"
            CornerRadius="10" Background="White"
            BorderBrush="#2E2E2E" BorderThickness="1"
            Padding="8" HorizontalAlignment="Left" Width="278" Height="58" VerticalAlignment="Top" Margin="48,170,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.35"/>
            </Border.Effect>
            <TextBox x:Name="markadisservis"
                Text="Marka"
                GotFocus="markadisservis_GotFocus"
                LostFocus="markadisservis_LostFocus"
                Background="White" BorderThickness="0"
                Foreground="#FF848484" FontSize="14"
                VerticalContentAlignment="Center" Padding="5"/>
        </Border>
        <Border x:Name="modeldisservisborder"
            CornerRadius="10" Background="White"
            BorderBrush="#2E2E2E" BorderThickness="1"
            Padding="8" HorizontalAlignment="Left" Width="278" Height="58" VerticalAlignment="Top" Margin="48,233,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.35"/>
            </Border.Effect>
            <TextBox x:Name="modeldisservis"
                Text="Model"
                GotFocus="modeldisservis_GotFocus"
                LostFocus="modeldisservis_LostFocus"
                Background="White" BorderThickness="0"
                Foreground="#FF848484" FontSize="14"
                VerticalContentAlignment="Center" Padding="5"/>
        </Border>
        <Border x:Name="ilgiliteknisyendisservis1_Kopyala4"
            CornerRadius="10" Background="White"
            BorderBrush="#2E2E2E" BorderThickness="1"
            Padding="8" HorizontalAlignment="Center" Width="192" Height="247" VerticalAlignment="Top" Margin="0,44,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.35"/>
            </Border.Effect>
            <TextBox x:Name="arizadisservis"
                Text="Arıza"
                GotFocus="arizadisservis_GotFocus"
                LostFocus="arizadisservis_LostFocus"
                Background="White" BorderThickness="0"
                Foreground="#FF848484" FontSize="14"
                VerticalContentAlignment="Center" Padding="5"/>
        </Border>
        <Button x:Name="btnFisYazdir" 
        Content="🖨 FİŞ YAZDIR" 
        Click="btnFisYazdir_Click" 
        Background="#34495E" 
        Foreground="White" 
        FontWeight="Bold" 
        Padding="10" 
        Margin="565,49,175,369" 
        Cursor="Hand"/>
    </Grid>

</Page>

