<Page x:Class="alpsoftservistakip.PageToptanciListesi"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:alpsoftservistakip"
      mc:Ignorable="d" 
      d:DesignHeight="950" d:DesignWidth="1400"
      Background="#0D1017"
      Title="Toptancı Yönetimi">

    <Page.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#3B82F6"/>
        <SolidColorBrush x:Key="SecondaryDark" Color="#F8FAFC"/>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#151923"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="55"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#252D3D"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#181D29"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#252D3D"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#151923"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E3A8A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TopActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,10"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopBackBtn" TargetType="Button" BasedOn="{StaticResource TopActionBtn}">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#252D3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TopPrimaryBtn" TargetType="Button" BasedOn="{StaticResource TopActionBtn}">
            <Setter Property="Background" Value="#2563EB"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Üst Başlık ve Geri Dön Butonu -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="5" Height="35" Background="{StaticResource PrimaryColor}" Margin="0,0,15,0" CornerRadius="2"/>
                <TextBlock Text="Toptancı Yönetimi" FontSize="28" FontWeight="ExtraBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
            </StackPanel>

            <Button HorizontalAlignment="Right" Content="ANA MENÜYE DÖN" Width="220" Click="btnGeri_Click" Style="{StaticResource TopBackBtn}"/>
        </Grid>

        <!-- Arama ve Cari Ekle -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <!-- Arama Kutusu -->
                <Border Width="400" Height="45" CornerRadius="10" Background="#181D29" BorderBrush="#252D3D" BorderThickness="1">
                    <Grid>
                        <TextBox x:Name="txtArama" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" Padding="15,0" 
                                 VerticalContentAlignment="Center" FontSize="14" TextChanged="txtArama_TextChanged" CaretBrush="#3B82F6"/>
                        <TextBlock Text="Toptancı Adı Ara..." Foreground="#64748B" Margin="15,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtArama}" Value="">
                                             <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Arama Temizle -->
                <Button Content="Temizle" Margin="10,0,0,0" Height="45" Width="100" Click="btnTemizle_Click"
                        Background="#181D29" Foreground="#94A3B8" FontWeight="SemiBold" BorderBrush="#252D3D" BorderThickness="1" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <!-- Sağ Taraf: CARİ EKLE BUTONU -->
            <Button Content="+ YENİ TOPTANCI EKLE" Style="{StaticResource TopPrimaryBtn}" Width="250" HorizontalAlignment="Right" Click="btnYeniToptanci_Click"/>
        </Grid>

        <!-- DataGrid (Tablo) -->
        <Border Grid.Row="2" Background="#151923" CornerRadius="12" Padding="15" BorderBrush="#252D3D" BorderThickness="1">
            <DataGrid x:Name="dgToptancilar" AutoGenerateColumns="False" IsReadOnly="True" 
                      SelectionMode="Single" MouseDoubleClick="dgToptancilar_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Kayıt No" Binding="{Binding ID}" Width="100"/>
                    <DataGridTextColumn Header="Firma Adı" Binding="{Binding FirmaAdi}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Telefon" Binding="{Binding Telefon}" Width="150"/>
                    <DataGridTextColumn Header="Oluşturulma Tarihi" Binding="{Binding OlusturulmaTarihi, StringFormat=dd.MM.yyyy}" Width="200"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
