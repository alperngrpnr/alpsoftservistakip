<Page x:Class="alpsoftservistakip.PageToptanciListesi"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:alpsoftservistakip"
      mc:Ignorable="d" 
      d:DesignHeight="950" d:DesignWidth="1400"
      Background="#F0F4F8"
      Title="Toptancı Yönetimi">

    <Page.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#3498DB"/>
        <SolidColorBrush x:Key="SecondaryDark" Color="#2C3E50"/>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="55"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF2F7"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E1F0FA"/>
                    <Setter Property="Foreground" Value="#2C3E50"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TopActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,10"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopBackBtn" TargetType="Button" BasedOn="{StaticResource TopActionBtn}">
            <Setter Property="Background" Value="{StaticResource SecondaryDark}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1F2D3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TopPrimaryBtn" TargetType="Button" BasedOn="{StaticResource TopActionBtn}">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Üst Başlık ve Geri Dön Butonu -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <Border Width="5" Height="35" Background="{StaticResource PrimaryColor}" Margin="0,0,15,0"/>
                <TextBlock Text="Toptancı Yönetimi" FontSize="30" FontWeight="ExtraBold" Foreground="{StaticResource SecondaryDark}"/>
            </StackPanel>

            <Button HorizontalAlignment="Right" Content="ANA MENÜYE DÖN" Width="220" Click="btnGeri_Click" Style="{StaticResource TopBackBtn}"/>
        </Grid>

        <!-- Arama ve Cari Ekle -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <!-- Arama Kutusu -->
                <Border Width="400" Height="45" CornerRadius="22.5" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <TextBox x:Name="txtArama" Background="Transparent" BorderThickness="0" Padding="20,0" 
                                 VerticalContentAlignment="Center" FontSize="14" TextChanged="txtArama_TextChanged"/>
                        <TextBlock Text="Toptancı Adı Ara..." Foreground="#A0AEC0" Margin="20,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtArama}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Arama Temizle -->
                <Button Content="Temizle" Margin="10,0,0,0" Height="45" Width="100" Click="btnTemizle_Click"
                        Background="White" Foreground="#2C3E50" FontWeight="SemiBold" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="22.5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <!-- Sağ Taraf: CARİ EKLE BUTONU -->
            <Button Content="+ YENİ TOPTANCI EKLE" Style="{StaticResource TopPrimaryBtn}" Width="250" HorizontalAlignment="Right" Click="btnYeniToptanci_Click"/>
        </Grid>

        <!-- DataGrid (Tablo) -->
        <Border Grid.Row="2" Background="White" CornerRadius="15" Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Opacity="0.05" ShadowDepth="5" Color="Black"/>
            </Border.Effect>

            <DataGrid x:Name="dgToptancilar" AutoGenerateColumns="False" IsReadOnly="True" 
                      SelectionMode="Single" MouseDoubleClick="dgToptancilar_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Kayıt No" Binding="{Binding ID}" Width="100"/>
                    <DataGridTextColumn Header="Firma Adı" Binding="{Binding FirmaAdi}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{StaticResource SecondaryDark}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Telefon" Binding="{Binding Telefon}" Width="150"/>
                    <DataGridTextColumn Header="Oluşturulma Tarihi" Binding="{Binding OlusturulmaTarihi, StringFormat=dd.MM.yyyy}" Width="200"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
