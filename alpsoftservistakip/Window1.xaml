<Window x:Class="alpsoftservistakip.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:alpsoftservistakip.Controls"
        Title="Alpsoft - Giriş" Height="610" Width="400" 
        WindowStartupLocation="CenterScreen" WindowStyle="None" 
        AllowsTransparency="True" Background="Transparent">

    <Border Background="White" CornerRadius="25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Color="#DDAAAAAA" Direction="270" ShadowDepth="5"/>
        </Border.Effect>

        <Grid>
            <StackPanel Margin="35,10,35,10">
                <TextBlock Text="ALPSOFT" Foreground="#FF252B36" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Kullanıcı Girişi" Foreground="#888" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,20"/>

                <Image Source="https://cdn-icons-png.flaticon.com/512/295/295128.png" Height="80" Margin="0,0,0,20"/>

                <TextBlock Text="E-posta" Foreground="#555" Margin="5,0,0,5" FontWeight="SemiBold"/>
                <Border BorderBrush="#EEE" BorderThickness="2" CornerRadius="10" Background="#F5F5F5" Margin="0,0,0,15">
                    <TextBox x:Name="txtUser" BorderThickness="0" Background="Transparent" Padding="12" FontSize="16" PreviewKeyDown="txtUser_PreviewKeyDown"/>
                </Border>

                <TextBlock Text="Şifre" Foreground="#555" Margin="5,0,0,5" FontWeight="SemiBold"/>
                <Border BorderBrush="#EEE" BorderThickness="2" CornerRadius="10" Background="#F5F5F5" Margin="0,0,0,5">
                    <PasswordBox x:Name="txtPass" BorderThickness="0" Background="Transparent" Padding="12" FontSize="16" PreviewKeyDown="txtPass_PreviewKeyDown"/>
                </Border>

                <TextBlock Text="Şifremi Unuttum" Foreground="#FFF5C721" FontSize="12" 
                           HorizontalAlignment="Right" Margin="0,0,5,10" Cursor="Hand"
                           MouseLeftButtonUp="SifremiUnuttum_Click"/>

                <CheckBox x:Name="chkHatirla" Content="E-postamı Hatırla" Foreground="#777" 
                          FontSize="13" Margin="5,0,0,15" Cursor="Hand">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>

                <Button x:Name="btnLogin" Content="GİRİŞ YAP" Background="#FFF5C721" Foreground="#FF252B36" 
                        Height="50" FontWeight="Bold" FontSize="16" Cursor="Hand" Click="btnLogin_Click"
                        IsDefault="True">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="12">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#FFF5C721"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                    <TextBlock Text="Hesabın yok mu?" Foreground="#777" FontSize="13"/>
                    <TextBlock Text=" Kayıt Ol" Foreground="#FFF5C721" FontSize="13" FontWeight="Bold" 
                               Cursor="Hand" MouseLeftButtonUp="KayitOl_Click" Margin="5,0,0,0"/>
                </StackPanel>

                <!-- Demo Giriş Butonu -->
                <Button x:Name="btnDemo" Content="UYGULAMAYI DEMO OLARAK DENE" Background="#FF252B36" Foreground="White" 
                        Height="40" Margin="0,20,0,0" FontWeight="Bold" FontSize="12" Cursor="Hand" Click="btnDemo_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

            </StackPanel>

            <!-- DEMO İSİM SORMA POPUP -->
            <Grid x:Name="GridDemoPopup" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="50">
                <Border Background="White" CornerRadius="15" Width="320" Height="250" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                    <StackPanel>
                        <TextBlock Text="DEMO SÜRÜM" FontSize="20" FontWeight="Bold" Foreground="#FF252B36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Hangi isimle denemek istiyorsunuz?" Foreground="#666" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,20"/>

                        <TextBox x:Name="txtDemoName" Height="40" FontSize="16" Padding="10,0" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,20" VerticalContentAlignment="Center"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="İPTAL" Background="#EEE" Foreground="#333" Height="40" FontWeight="Bold" Cursor="Hand" Click="btnDemoIptal_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button Grid.Column="2" Content="BAŞLA" Background="#FFF5C721" Foreground="#FF252B36" Height="40" FontWeight="Bold" Cursor="Hand" Click="btnDemoBasla_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Overlay host for in-window pages -->
            <local:OverlayHost x:Name="OverlayHost" Panel.ZIndex="999"/>
        </Grid>
    </Border>
</Window>
