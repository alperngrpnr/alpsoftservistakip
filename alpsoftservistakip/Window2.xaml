<Window x:Class="alpsoftservistakip.WindowRegister"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alpsoft - Kayıt Ol" 
        Height="720" Width="420"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None"
        Background="Transparent" 
        AllowsTransparency="True">

    <Border Background="White" CornerRadius="25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Color="#DDAAAAAA" Direction="270" ShadowDepth="5"/>
        </Border.Effect>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="35,25,35,25">

                    <TextBlock Text="ALPSOFT" Foreground="#FF252B36" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Yeni Şirket Kaydı" Foreground="#888" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,20"/>

                    <TextBlock Text="Ad Soyad" Foreground="#555" Margin="5,0,0,5" FontWeight="SemiBold"/>
                    <Border BorderBrush="#EEE" BorderThickness="2" CornerRadius="10" Background="#F5F5F5" Margin="0,0,0,12">
                        <TextBox x:Name="txtFullName" BorderThickness="0" Background="Transparent" Padding="10" FontSize="14"/>
                    </Border>

                    <TextBlock Text="E-posta" Foreground="#555" Margin="5,0,0,5" FontWeight="SemiBold"/>
                    <Border BorderBrush="#EEE" BorderThickness="2" CornerRadius="10" Background="#F5F5F5" Margin="0,0,0,12">
                        <TextBox x:Name="txtEmail" BorderThickness="0" Background="Transparent" Padding="10" FontSize="14"/>
                    </Border>

                    <TextBlock Text="Şifre" Foreground="#555" Margin="5,0,0,5" FontWeight="SemiBold"/>
                    <Border BorderBrush="#EEE" BorderThickness="2" CornerRadius="10" Background="#F5F5F5" Margin="0,0,0,12">
                        <PasswordBox x:Name="txtPassword" BorderThickness="0" Background="Transparent" Padding="10" FontSize="14"/>
                    </Border>

                    <TextBlock Text="Şifre Tekrar" Foreground="#555" Margin="5,0,0,5" FontWeight="SemiBold"/>
                    <Border BorderBrush="#EEE" BorderThickness="2" CornerRadius="10" Background="#F5F5F5" Margin="0,0,0,12">
                        <PasswordBox x:Name="txtPasswordRepeat" BorderThickness="0" Background="Transparent" Padding="10" FontSize="14"/>
                    </Border>

                    <TextBlock Text="Şirket Adı" Foreground="#555" Margin="5,0,0,5" FontWeight="SemiBold"/>
                    <Border BorderBrush="#EEE" BorderThickness="2" CornerRadius="10" Background="#F5F5F5" Margin="0,0,0,12">
                        <TextBox x:Name="txtCompanyName" BorderThickness="0" Background="Transparent" Padding="10" FontSize="14"/>
                    </Border>

                    <TextBlock Text="Aktivasyon Kodu" Foreground="#555" Margin="5,0,0,5" FontWeight="SemiBold"/>
                    <Border BorderBrush="#EEE" BorderThickness="2" CornerRadius="10" Background="#F5F5F5" Margin="0,0,0,20">
                        <TextBox x:Name="txtActivationCode" MaxLength="17" BorderThickness="0" Background="Transparent" Padding="10" FontSize="14"/>
                    </Border>

                    <Button x:Name="BtnRegister" Content="KAYIT OL" Background="#FFF5C721" Foreground="#FF252B36" 
                            Height="45" FontWeight="Bold" FontSize="15" Cursor="Hand" Click="BtnRegister_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#1976D2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <TextBlock Text="Zaten hesabın var mı?" Foreground="#777" FontSize="13"/>
                        <TextBlock Text=" Giriş Yap" Foreground="#FFF5C721" FontSize="13" FontWeight="Bold" 
                                   Cursor="Hand" MouseLeftButtonUp="BtnLogin_Click" Margin="5,0,0,0"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>