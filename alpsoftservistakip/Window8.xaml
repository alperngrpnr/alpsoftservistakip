<Window x:Class="alpsoftservistakip.Window8"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Yükleniyor"
        Width="500"
        Height="320"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <!-- 🔹 ANİMASYONLAR -->
    <Window.Resources>
        <Storyboard x:Key="RotateAnim">
            <DoubleAnimation
                Storyboard.TargetName="RotateTransform"
                Storyboard.TargetProperty="Angle"
                From="0"
                To="360"
                Duration="0:0:1.2"
                RepeatBehavior="Forever"/>
        </Storyboard>

        <Storyboard x:Key="FadeAnim">
            <DoubleAnimation
                Storyboard.TargetName="GlowRing"
                Storyboard.TargetProperty="Opacity"
                From="0.4"
                To="1"
                Duration="0:0:0.8"
                AutoReverse="True"
                RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>

    <Grid>

        <!-- ANA KART -->
        <Border Width="420"
                Height="260"
                Background="#FFF5C721"
                CornerRadius="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="35"
                                  ShadowDepth="0"
                                  Opacity="0.35"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <Image Source="/transparan AlpSoft.png"
                       Width="110"
                       Height="110"
                       Margin="0,0,0,12"/>

                <TextBlock Text="İnternet Bağlantısı Bekleniyor..."
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#1E2A5E"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- MODERN SPINNER -->
                <Grid Width="70" Height="70">

                    <Ellipse Width="70"
                             Height="70"
                             Stroke="#E0E0E0"
                             StrokeThickness="6"/>

                    <Ellipse x:Name="GlowRing"
                             Width="70"
                             Height="70"
                             Stroke="Black"
                             StrokeThickness="6"
                             StrokeDashArray="1.5 4"
                             StrokeStartLineCap="Round"
                             StrokeEndLineCap="Round"
                             RenderTransformOrigin="0.5,0.5">

                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="RotateTransform"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Window>
