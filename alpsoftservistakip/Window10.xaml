<Window x:Class="alpsoftservistakip.Window10"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AlpSoft"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Width="500"
        Height="700"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="25"
            Background="#FFF5C721"
            Padding="20">

        <Grid>

            <!-- LOGO -->
            <Image Source="/transparan AlpSoft.png"
                   Width="220"
                   Height="220"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,120"/>

            <!-- YÜKLENİYOR YAZISI -->
            <TextBlock Text="Yükleniyor..."
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#222"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,200,0,0"/>

            <!-- LOADING -->
            <ProgressBar Width="200"
                         Height="6"
                         IsIndeterminate="True"
                         Foreground="#222"
                         Background="#66FFFFFF"
                         VerticalAlignment="Bottom"
                         Margin="0,0,0,60"/>

        </Grid>

    </Border>
</Window>
