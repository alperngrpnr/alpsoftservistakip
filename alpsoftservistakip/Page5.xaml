<Page x:Class="alpsoftservistakip.Page5"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:alpsoftservistakip.ViewModels"
      xmlns:conv="clr-namespace:alpsoftservistakip.Converters"
      mc:Ignorable="d"
      Background="#0D1017">

    <Page.Resources>
        <!-- JObject Binding Converter -->
        <conv:JObjectPropertyConverter x:Key="JObjectPropertyConverter"/>
        
        <!-- Theme Colors -->
        <SolidColorBrush x:Key="BgPage" Color="#0D1017"/>
        <SolidColorBrush x:Key="BgCard" Color="#151923"/>
        <SolidColorBrush x:Key="BgInput" Color="#181D29"/>
        <SolidColorBrush x:Key="BorderNormal" Color="#252D3D"/>
        <SolidColorBrush x:Key="BorderFocus" Color="#3B82F6"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#2563EB"/>

        <!-- DatePicker Style Dark -->
        <Style TargetType="{x:Type DatePicker}">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderNormal}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="IsTodayHighlighted" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DatePicker}">
                        <Grid x:Name="PART_Root">
                            <Border x:Name="borderRoot" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <DatePickerTextBox x:Name="PART_TextBox" 
                                                       Grid.Column="0"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       Background="Transparent"
                                                       BorderThickness="0"
                                                       Padding="10,0"
                                                       VerticalContentAlignment="Center"
                                                       Focusable="False"
                                                       IsReadOnly="True">
                                        <DatePickerTextBox.Style>
                                            <Style TargetType="{x:Type DatePickerTextBox}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                                                            <Grid>
                                                                <TextBox x:Name="PART_TextBox"
                                                                         Text="{Binding Path=SelectedDate, RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}, StringFormat='dd.MM.yyyy'}"
                                                                         Background="Transparent"
                                                                         Foreground="{StaticResource TextPrimary}"
                                                                         BorderThickness="0"
                                                                         VerticalContentAlignment="Center"
                                                                         Padding="0"
                                                                         IsReadOnly="True"/>
                                                                <TextBlock x:Name="PART_Watermark"
                                                                           Text="Tarih Seçin..."
                                                                           Foreground="{StaticResource TextMuted}"
                                                                           VerticalAlignment="Center"
                                                                           Padding="2,0,0,0"
                                                                           Visibility="Collapsed"/>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Path=SelectedDate, RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}}" Value="{x:Null}">
                                                                    <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </DatePickerTextBox.Style>
                                    </DatePickerTextBox>
                                    
                                    <Button x:Name="PART_Button" 
                                            Grid.Column="1"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Width="36"
                                            Cursor="Hand"
                                            Focusable="False"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Button.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Button.RenderTransform>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="Transparent" CornerRadius="0,7,7,0">
                                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="13" 
                                                               Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#1E293B"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#0F172A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   Placement="Bottom" 
                                   PlacementTarget="{Binding ElementName=PART_Root}" 
                                   StaysOpen="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borderRoot" Property="BorderBrush" Value="{StaticResource BorderFocus}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#261618"/>
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="BorderBrush" Value="#7F1D1D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3B1D20"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#EF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="Background" Value="#1A0D0F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Dark Styles -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="48"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#1F2533"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#11141C"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderNormal}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#171C27"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#222938"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E3A8A"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6,2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource BgPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP TITLE & HEADER -->
        <Grid Grid.Row="0" Margin="24,20,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="28" Background="{StaticResource PrimaryColor}" Margin="0,0,12,0" CornerRadius="2"/>
                <Border Width="30" Height="30" CornerRadius="7" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE14C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Servis Kayıtları" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Aktif, işlemdeki ve tamamlanan servis kayıtlarını yönetin" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </StackPanel>

            <!-- Geri Dön Butonu -->
            <Button Grid.Column="1" x:Name="geridön" Click="geridön_Click" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Button.RenderTransform>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#181D29" BorderBrush="{StaticResource BorderNormal}" BorderThickness="1" CornerRadius="8" Padding="14,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Ana Menü" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#252D3D"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderFocus}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="Background" Value="#11141C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- FILTERS & ACTIONS BAR -->
        <Grid Grid.Row="1" Margin="24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Arama Kutusu -->
                <Border x:Name="aramaborder"
                        CornerRadius="8" 
                        Background="{StaticResource BgInput}"
                        BorderBrush="{StaticResource BorderNormal}" 
                        BorderThickness="1"
                        Width="280" Height="38">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" 
                                   Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="arama"
                                 Text="{Binding AramaMetni, UpdateSourceTrigger=PropertyChanged}"
                                 GotFocus="arama_GotFocus"
                                 LostFocus="arama_LostFocus"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimary}" FontSize="13"
                                 VerticalContentAlignment="Center" Padding="0,0,10,0"/>
                    </Grid>
                </Border>

                <!-- Modern Tarih Filtresi -->
                <DatePicker x:Name="dtpServisTarihi" 
                            Width="160" Margin="12,0,0,0"
                            SelectedDate="{Binding SecilenTarih, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Filtreyi Kaldır Butonu -->
                <Button x:Name="btnFiltreTemizle" 
                        Content="Filtreyi Temizle" 
                        Margin="10,0,0,0" 
                        Height="38" 
                        Style="{StaticResource ModernButtonStyle}"
                        Command="{Binding FiltreTemizleCommand}"/>
            </StackPanel>

            <!-- Fiş Yazdır Butonu -->
            <Button Grid.Column="1" x:Name="btnFisiYazdir" 
                    Height="38"
                    Cursor="Hand"
                    RenderTransformOrigin="0.5,0.5"
                    Command="{Binding FisiYazdirCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=dgVeriler}">
                <Button.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Button.RenderTransform>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#0C201A" BorderBrush="#065F46" BorderThickness="1" CornerRadius="8" Padding="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#10B981" Margin="0,1,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Fiş Yazdır" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14342A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="Background" Value="#061A13"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- DATAGRID KARTI -->
        <Border Grid.Row="2" Background="{StaticResource BgCard}" Margin="24,0,24,24" CornerRadius="10" BorderBrush="{StaticResource BorderNormal}" BorderThickness="1">
            <DataGrid x:Name="dgVeriler"
                      ItemsSource="{Binding Kayitlar}"
                      AutoGenerateColumns="False"  
                      IsReadOnly="True" 
                      AlternationCount="2"
                      MouseDoubleClick="dgVeriler_MouseDoubleClick" 
                      Margin="8"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ., Converter={StaticResource JObjectPropertyConverter}, ConverterParameter=ID}" Width="60"/>

                    <DataGridTextColumn Header="GİRİŞ TARİHİ" 
                                        Binding="{Binding ., Converter={StaticResource JObjectPropertyConverter}, ConverterParameter=KayitTarihi}" 
                                        Width="140"/>

                    <DataGridTextColumn Header="BAYİ ADI" Binding="{Binding ., Converter={StaticResource JObjectPropertyConverter}, ConverterParameter=BayiAdi}" Width="140"/>

                    <DataGridTextColumn Header="MÜŞTERİ" Binding="{Binding ., Converter={StaticResource JObjectPropertyConverter}, ConverterParameter=IsimSoyisim}" Width="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="TELEFON" Binding="{Binding ., Converter={StaticResource JObjectPropertyConverter}, ConverterParameter=CepTelefonu}" Width="130"/>
                    <DataGridTextColumn Header="CİHAZ" Binding="{Binding ., Converter={StaticResource JObjectPropertyConverter}, ConverterParameter=CihazTuru}" Width="110"/>
                    <DataGridTextColumn Header="MARKA" Binding="{Binding ., Converter={StaticResource JObjectPropertyConverter}, ConverterParameter=Marka}" Width="100"/>
                    <DataGridTextColumn Header="MODEL" Binding="{Binding ., Converter={StaticResource JObjectPropertyConverter}, ConverterParameter=Model}" Width="110"/>

                    <DataGridTextColumn Header="ARIZA DETAYI" Binding="{Binding ., Converter={StaticResource JObjectPropertyConverter}, ConverterParameter=Ariza}" Width="*"/>

                    <DataGridTextColumn Header="DURUM" Binding="{Binding ., Converter={StaticResource JObjectPropertyConverter}, ConverterParameter=ServisDurumu}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="E-Posta" Binding="{Binding ., Converter={StaticResource JObjectPropertyConverter}, ConverterParameter=EPosta}" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="Adres" Binding="{Binding ., Converter={StaticResource JObjectPropertyConverter}, ConverterParameter=Adres}" Visibility="Collapsed"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
