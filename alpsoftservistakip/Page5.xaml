<Page x:Class="alpsoftservistakip.Page5"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:alpsoftservistakip.ViewModels"
      mc:Ignorable="d"
      Background="#F4F7F9">

    <Page.Resources>
        <!-- DatePicker Style -->
        <Style TargetType="{x:Type DatePicker}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCDDE1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="IsTodayHighlighted" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DatePicker}">
                        <Grid x:Name="PART_Root">
                            <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <DatePickerTextBox x:Name="PART_TextBox" 
                                             Grid.Column="0"
                                             Foreground="{TemplateBinding Foreground}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             Focusable="False"
                                             IsReadOnly="True">
                                        <DatePickerTextBox.Style>
                                            <Style TargetType="{x:Type DatePickerTextBox}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                                                            <Grid>
                                                                <TextBox x:Name="PART_TextBox"
                                                                       Text="{Binding Path=SelectedDate, RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}, StringFormat='dd.MM.yyyy'}"
                                                                       Background="Transparent"
                                                                       Foreground="{TemplateBinding Foreground}"
                                                                       BorderThickness="0"
                                                                       VerticalContentAlignment="Center"
                                                                       Padding="0"
                                                                       IsReadOnly="True"/>
                                                                <TextBlock x:Name="PART_Watermark"
                                                                         Text="Tarih Seçin..."
                                                                         Foreground="#95A5A6"
                                                                         VerticalAlignment="Center"
                                                                         Padding="2,0,0,0"
                                                                         Visibility="Collapsed"/>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Path=SelectedDate, RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}}" Value="{x:Null}">
                                                                    <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </DatePickerTextBox.Style>
                                    </DatePickerTextBox>
                                    <Button x:Name="PART_Button" 
                                    Grid.Column="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="40"
                                    Cursor="Hand"
                                    Focusable="False">
                                        <Path Data="M19,4H5A2,2 0 0,0 3,6V20A2,2 0 0,0 5,22H19A2,2 0 0,0 21,20V6A2,2 0 0,0 19,4M19,20H5V10H19V20M5,8V6H19V8H5M7,12H12V17H7V12Z" 
                                      Fill="#3498DB" 
                                      Stretch="Uniform" 
                                      Width="18" 
                                      Height="18"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup" 
                           AllowsTransparency="True" 
                           Placement="Bottom" 
                           PlacementTarget="{Binding ElementName=PART_Root}" 
                           StaysOpen="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#3498DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="15,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C0392B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#A93226"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type DataGrid}" x:Key="ModernDataGridStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F0F0F0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#252B36"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#3D4655"/>
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F0F0F0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F9FBFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E6F2FF"/>
                    <Setter Property="Foreground" Value="#007ACC"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" 
                                              HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" Background="#F4F7F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Arama Kutusu -->
                <Border x:Name="aramaborder"
                        CornerRadius="20" 
                        Background="White"
                        BorderBrush="#DCDDE1" 
                        BorderThickness="1"
                        Width="300" Height="40">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="1" Opacity="0.1"/>
                    </Border.Effect>
                    <TextBox x:Name="arama"
                             Text="{Binding AramaMetni, UpdateSourceTrigger=PropertyChanged}"
                             GotFocus="arama_GotFocus"
                             LostFocus="arama_LostFocus"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#7F8C8D" FontSize="14"
                             VerticalContentAlignment="Center" Padding="15,0"/>
                </Border>

                <!-- Modern Tarih Filtresi -->
                <Border Background="White" CornerRadius="10" Padding="15,8" Margin="20,0,0,0" BorderBrush="#DCDDE1" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="1" Opacity="0.1"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <DatePicker x:Name="dtpServisTarihi" 
                                    Width="180"
                                    SelectedDate="{Binding SecilenTarih, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                <!-- Filtreyi Kaldır Butonu -->
                <Button x:Name="btnFiltreTemizle" 
                        Content="🗑 Filtreyi Kaldır" 
                        Margin="15,0,0,0" 
                        Height="40" 
                        Width="150"
                        Style="{StaticResource ModernButtonStyle}"
                        Command="{Binding FiltreTemizleCommand}"/>
            </StackPanel>

            <!-- Geri Dön Butonu -->
            <Button x:Name="geridön" Content="← ANA MENÜ"
                    FontSize="14"
                    Foreground="White"
                    Background="#FF252B36"
                    BorderThickness="0"
                    Cursor="Hand" 
                    FontWeight="Bold"
                    Click="geridön_Click" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center" 
                    Width="150" Height="40">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="20"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="White" Margin="20,0,20,20" CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>

            <DataGrid x:Name="dgVeriler"
                      Style="{StaticResource ModernDataGridStyle}" 
                      ItemsSource="{Binding Kayitlar}"
                      AutoGenerateColumns="False"  
                      IsReadOnly="True" 
                      MouseDoubleClick="dgVeriler_MouseDoubleClick" 
                      Margin="10"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="60"/>

                    <DataGridTextColumn Header="GİRİŞ TARİHİ" 
                                        Binding="{Binding ServisTarihi, StringFormat='\{0:dd.MM.yyyy HH:mm\}'}" 
                                        Width="150"/>

                    <DataGridTextColumn Header="BAYİ ADI" Binding="{Binding BayiAdi}" Width="150"/>

                    <DataGridTextColumn Header="MÜŞTERİ" Binding="{Binding IsimSoyisim}" Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="TELEFON" Binding="{Binding CepTelefonu}" Width="130"/>
                    <DataGridTextColumn Header="CİHAZ" Binding="{Binding CihazTuru}" Width="120"/>
                    <DataGridTextColumn Header="MARKA" Binding="{Binding Marka}" Width="100"/>
                    <DataGridTextColumn Header="MODEL" Binding="{Binding Model}" Width="120"/>

                    <DataGridTextColumn Header="ARIZA DETAYI" Binding="{Binding Ariza}" Width="250"/>

                    <DataGridTextColumn Header="DURUM" Binding="{Binding ServisDurumu}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="E-Posta" Binding="{Binding EPosta}" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="Adres" Binding="{Binding Adres}" Visibility="Collapsed"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>

