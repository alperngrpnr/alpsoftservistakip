<Page x:Class="alpsoftservistakip.PageToptanciEkle"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:alpsoftservistakip"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Background="#F0F4F8"
      Title="PageToptanciEkle">

    <Page.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#3498DB"/>
        <SolidColorBrush x:Key="SecondaryDark" Color="#2C3E50"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#2ECC71"/>

        <!-- Stil: Başlık Yazıları -->
        <Style TargetType="TextBlock" x:Key="FormLabelStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Stil: TextBox -->
        <Style TargetType="TextBox" x:Key="FormInputStyle">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stil: Kaydet Butonu -->
        <Style x:Key="SaveButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SuccessColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#27AE60"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Üst Başlık ve Geri Dön -->
        <Grid Grid.Row="0" Margin="0,0,0,30">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="📦" FontSize="36" Margin="0,0,15,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtUstBaslik" Text="YENİ TOPTANCI EKLE" FontSize="32" FontWeight="ExtraBold" Foreground="{StaticResource SecondaryDark}" VerticalAlignment="Center"/>
            </StackPanel>

            <Button HorizontalAlignment="Right" Content="✕ VAZGEÇ" Width="160" Height="45" Click="btnIptal_Click"
                    Background="White" Foreground="#E74C3C" BorderBrush="#E74C3C" BorderThickness="2" FontWeight="Bold" FontSize="14" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="22.5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Form Alanı -->
        <Border Grid.Row="1" Background="White" CornerRadius="25" Padding="50" MaxWidth="900" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" Opacity="0.08" ShadowDepth="10" Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/> <!-- Genişletildi -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sol Sütun -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Toptancı Adı / Firma Ünvanı *" Style="{StaticResource FormLabelStyle}" Foreground="#2C3E50" FontSize="16"/>
                    <TextBox x:Name="txtFirmaAdi" Style="{StaticResource FormInputStyle}" Height="50" FontSize="16" Margin="0,0,0,25"/>

                    <TextBlock Text="Telefon Numarası" Style="{StaticResource FormLabelStyle}" Foreground="#2C3E50" FontSize="16"/>
                    <TextBox x:Name="txtTelefon" Style="{StaticResource FormInputStyle}" Height="50" FontSize="16" MaxLength="15" Margin="0,0,0,25"/>
                </StackPanel>

                <!-- Sağ Sütun -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="IBAN Bilgisi" Style="{StaticResource FormLabelStyle}" Foreground="#2C3E50" FontSize="16"/>
                    <TextBox x:Name="txtIBAN" Style="{StaticResource FormInputStyle}" Height="50" FontSize="16" MaxLength="34" Margin="0,0,0,25"/>

                    <TextBlock Text="Açıklama / Notlar" Style="{StaticResource FormLabelStyle}" Foreground="#2C3E50" FontSize="16"/>
                    <TextBox x:Name="txtAciklama" Style="{StaticResource FormInputStyle}" Height="95" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="15,10" Margin="0,0,0,25"/>

                    <Button x:Name="btnKaydet" Content="💾 KAYDET" Style="{StaticResource SaveButton}" Margin="0,15,0,0" Click="btnKaydet_Click" Height="60" FontSize="18"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
