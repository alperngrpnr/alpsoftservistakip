<Page x:Class="alpsoftservistakip.PageToptanciEkle"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:alpsoftservistakip"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Background="#0D1017"
      Title="PageToptanciEkle">

    <Page.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#3B82F6"/>
        <SolidColorBrush x:Key="SecondaryDark" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#10B981"/>

        <!-- Stil: Başlık Yazıları -->
        <Style TargetType="TextBlock" x:Key="FormLabelStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Stil: TextBox -->
        <Style TargetType="TextBox" x:Key="FormInputStyle">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#181D29"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#252D3D"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="CaretBrush" Value="#3B82F6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Stil: Kaydet Butonu -->
        <Style x:Key="SaveButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SuccessColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Üst Başlık ve Geri Dön -->
        <Grid Grid.Row="0" Margin="0,0,0,30">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="📦" FontSize="32" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtUstBaslik" Text="YENİ TOPTANCI EKLE" FontSize="28" FontWeight="ExtraBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
            </StackPanel>

            <Button HorizontalAlignment="Right" Content="✕ VAZGEÇ" Width="140" Height="42" Click="btnIptal_Click"
                    Background="#1E293B" Foreground="#EF4444" BorderBrush="#EF4444" BorderThickness="1" FontWeight="Bold" FontSize="13" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Form Alanı -->
        <Border Grid.Row="1" Background="#151923" CornerRadius="16" Padding="50" MaxWidth="900" HorizontalAlignment="Center" BorderBrush="#252D3D" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sol Sütun -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Toptancı Adı / Firma Ünvanı *" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="txtFirmaAdi" Style="{StaticResource FormInputStyle}" Height="50" FontSize="15" Margin="0,0,0,25"/>

                    <TextBlock Text="Telefon Numarası" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="txtTelefon" Style="{StaticResource FormInputStyle}" Height="50" FontSize="15" MaxLength="15" Margin="0,0,0,25"/>
                </StackPanel>

                <!-- Sağ Sütun -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="IBAN Bilgisi" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="txtIBAN" Style="{StaticResource FormInputStyle}" Height="50" FontSize="15" MaxLength="34" Margin="0,0,0,25"/>

                    <TextBlock Text="Açıklama / Notlar" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="txtAciklama" Style="{StaticResource FormInputStyle}" Height="95" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="15,10" Margin="0,0,0,25"/>

                    <Button x:Name="btnKaydet" Content="💾 KAYDET" Style="{StaticResource SaveButton}" Margin="0,15,0,0" Click="btnKaydet_Click" Height="55" FontSize="16"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
