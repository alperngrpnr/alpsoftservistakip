<Window x:Class="alpsoftservistakip.Window14"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Şifre Sıfırlama" Height="350" Width="400" 
        WindowStartupLocation="CenterScreen" Background="{x:Null}">

    <Border Background="White" CornerRadius="15" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Color="#DDD" ShadowDepth="2"/>
        </Border.Effect>

        <StackPanel Margin="20">
            <TextBlock x:Name="lblBilgi" Text="E-postanıza gelen 6 haneli kodu giriniz:" 
                       Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,10" TextAlignment="Center"/>

            <TextBox x:Name="txtCode" FontSize="22" FontWeight="Bold" 
                     HorizontalContentAlignment="Center" Padding="8" Margin="0,0,0,15"
                     BorderBrush="#2196F3" BorderThickness="2"/>

            <StackPanel x:Name="pnlYeniSifre" Visibility="Collapsed">
                <TextBlock Text="Yeni Şifre:" Foreground="#555" Margin="0,5,0,3"/>
                <PasswordBox x:Name="txtYeniSifre" Padding="8" FontSize="16" Margin="0,0,0,10"/>

                <TextBlock Text="Yeni Şifre (Tekrar):" Foreground="#555" Margin="0,5,0,3"/>
                <PasswordBox x:Name="txtYeniSifreTekrar" Padding="8" FontSize="16" Margin="0,0,0,15"/>
            </StackPanel>

            <Button x:Name="btnIslem" Content="KODU ONAYLA" Height="45" 
                    Background="#2196F3" Foreground="White" FontWeight="Bold" 
                    Cursor="Hand" Click="btnIslem_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
</Window>