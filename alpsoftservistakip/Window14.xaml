<Window x:Class="alpsoftservistakip.Window14"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Şifre Sıfırlama" Height="450" Width="400" 
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border Background="White" CornerRadius="25" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Color="#DDAAAAAA" Direction="270" ShadowDepth="5"/>
        </Border.Effect>

        <Grid>
            <!-- Üst Bar ve Kapat Butonu -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,15,0" Panel.ZIndex="10">
                <Border Width="30" Height="30" CornerRadius="15" Background="#F5F5F5" Cursor="Hand" MouseLeftButtonUp="Kapat_Click" ToolTip="Kapat">
                    <TextBlock Text="✕" FontSize="16" FontWeight="Bold" Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                </Border>
            </StackPanel>

            <StackPanel Margin="35,25,35,15" VerticalAlignment="Center">
                <TextBlock Text="ŞİFREYİ SIFIRLA" Foreground="#FF252B36" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Güvenlik Kodu Doğrulaması" Foreground="#888" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,25"/>

                <TextBlock x:Name="lblBilgi" Text="E-postanıza gelen 6 haneli kodu giriniz:" 
                           Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,10" TextAlignment="Center" TextWrapping="Wrap"/>

                <!-- Kod Giriş Alanı -->
                <Border x:Name="brdCode" BorderBrush="#EEE" BorderThickness="2" CornerRadius="10" Background="#F5F5F5" Margin="0,0,0,20">
                    <TextBox x:Name="txtCode" Background="Transparent" BorderThickness="0" FontSize="24" FontWeight="Bold" 
                             HorizontalContentAlignment="Center" Padding="12" Foreground="#FF252B36" MaxLength="6"/>
                </Border>

                <!-- Yeni Şifre Alanları (Önceden gizli) -->
                <StackPanel x:Name="pnlYeniSifre" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="Yeni Şifre" Foreground="#555" Margin="5,0,0,5" FontWeight="SemiBold"/>
                    <Border BorderBrush="#EEE" BorderThickness="2" CornerRadius="10" Background="#F5F5F5" Margin="0,0,0,15">
                        <PasswordBox x:Name="txtYeniSifre" BorderThickness="0" Background="Transparent" Padding="12" FontSize="16" Foreground="#FF252B36"/>
                    </Border>

                    <TextBlock Text="Yeni Şifre (Tekrar)" Foreground="#555" Margin="5,0,0,5" FontWeight="SemiBold"/>
                    <Border BorderBrush="#EEE" BorderThickness="2" CornerRadius="10" Background="#F5F5F5" Margin="0,0,0,5">
                        <PasswordBox x:Name="txtYeniSifreTekrar" BorderThickness="0" Background="Transparent" Padding="12" FontSize="16" Foreground="#FF252B36"/>
                    </Border>
                </StackPanel>

                <!-- İşlem Butonu -->
                <Button x:Name="btnIslem" Content="KODU ONAYLA" Background="#FFF5C721" Foreground="#FF252B36" 
                        Height="50" FontWeight="Bold" FontSize="16" Cursor="Hand" Click="btnIslem_Click" Margin="0,10,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="12">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#FFE0B21A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
