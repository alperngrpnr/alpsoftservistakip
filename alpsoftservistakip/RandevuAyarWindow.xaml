<Window x:Class="alpsoftservistakip.RandevuAyarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Randevu &amp; Çalışma Saatleri Ayarları"
        Height="540" Width="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#0E121B"
        AllowsTransparency="True"
        BorderBrush="#252D3D"
        BorderThickness="1">

    <Window.Resources>
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4,12,4"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#0E121B">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙️" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Randevu &amp; Çalışma Saatleri" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Her dükkan kendi çalışma günlerini ve saatlerini buradan belirler." FontSize="12" Foreground="#94A3B8" Margin="28,2,0,0"/>
                </StackPanel>
                <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="btnKapat_Click"/>
            </Grid>

            <!-- Body Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 1. Sistem Durumu Switch -->
                    <Border Background="#161C28" BorderBrush="#252D3D" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Online Randevu Sistemi" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13"/>
                                <TextBlock Text="Müşteriler web sitenizden randevu alabilsin mi?" FontSize="11.5" Foreground="#94A3B8"/>
                            </StackPanel>
                            <CheckBox x:Name="chkAktif" Content="Aktif" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ModernCheckBox}"/>
                        </Grid>
                    </Border>

                    <!-- 1.5 Dükkan Adresi ve Konum Bilgisi -->
                    <Border Background="#161C28" BorderBrush="#252D3D" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="📍 Dükkan / Servis Adresi (Web Randevu Sayfasında Gözükecek Adres)" FontWeight="Bold" Foreground="#38BDF8" FontSize="13" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtAdres" Height="36" Background="#0F1523" Foreground="#FFFFFF" BorderBrush="#252D3D" BorderThickness="1" Padding="10,0" FontSize="13" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="📍 Haritada Gör" Margin="8,0,0,0" Padding="12,0" Height="36" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#38BDF8" BorderThickness="1" FontWeight="Bold" Cursor="Hand" Click="btnKonumTest_Click" ToolTip="Adresi Google Haritalar'da test edin">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. Çalışma Günleri -->
                    <Border Background="#161C28" BorderBrush="#252D3D" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="📅 Randevu Kabul Edilen Günler" FontWeight="Bold" Foreground="#FFD026" FontSize="13" Margin="0,0,0,8"/>
                            <WrapPanel Margin="0,4,0,0">
                                <CheckBox x:Name="chkPzt" Content="Pazartesi" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                                <CheckBox x:Name="chkSal" Content="Salı" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                                <CheckBox x:Name="chkCar" Content="Çarşamba" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                                <CheckBox x:Name="chkPer" Content="Perşembe" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                                <CheckBox x:Name="chkCum" Content="Cuma" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                                <CheckBox x:Name="chkCmt" Content="Cumartesi" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                                <CheckBox x:Name="chkPaz" Content="Pazar" IsChecked="False" Style="{StaticResource ModernCheckBox}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 3. Çalışma Saatleri -->
                    <Border Background="#161C28" BorderBrush="#252D3D" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="⏰ Çalışma Saatleri Aralığı" FontWeight="Bold" Foreground="#FFD026" FontSize="13" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Açılış Saati" Foreground="#94A3B8" FontSize="11.5" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbBaslangic" Height="36" Background="#0A0E17" Foreground="#FFFFFF" BorderBrush="#2A3447">
                                        <ComboBoxItem Content="08:00"/>
                                        <ComboBoxItem Content="08:30"/>
                                        <ComboBoxItem Content="09:00" IsSelected="True"/>
                                        <ComboBoxItem Content="09:30"/>
                                        <ComboBoxItem Content="10:00"/>
                                        <ComboBoxItem Content="10:30"/>
                                        <ComboBoxItem Content="11:00"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Kapanış Saati" Foreground="#94A3B8" FontSize="11.5" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbBitis" Height="36" Background="#0A0E17" Foreground="#FFFFFF" BorderBrush="#2A3447">
                                        <ComboBoxItem Content="17:00"/>
                                        <ComboBoxItem Content="18:00"/>
                                        <ComboBoxItem Content="18:30"/>
                                        <ComboBoxItem Content="19:00" IsSelected="True"/>
                                        <ComboBoxItem Content="19:30"/>
                                        <ComboBoxItem Content="20:00"/>
                                        <ComboBoxItem Content="21:00"/>
                                        <ComboBoxItem Content="22:00"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 4. Slot ve Kapasite -->
                    <Border Background="#161C28" BorderBrush="#252D3D" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Randevu Süresi" Foreground="#94A3B8" FontSize="11.5" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbAralik" Height="36" Background="#0A0E17" Foreground="#FFFFFF" BorderBrush="#2A3447">
                                    <ComboBoxItem Content="15 Dakika"/>
                                    <ComboBoxItem Content="30 Dakika" IsSelected="True"/>
                                    <ComboBoxItem Content="45 Dakika"/>
                                    <ComboBoxItem Content="60 Dakika"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Aynı Saatte Maks. Randevu" Foreground="#94A3B8" FontSize="11.5" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbKapasite" Height="36" Background="#0A0E17" Foreground="#FFFFFF" BorderBrush="#2A3447">
                                    <ComboBoxItem Content="1 Kişi" IsSelected="True"/>
                                    <ComboBoxItem Content="2 Kişi"/>
                                    <ComboBoxItem Content="3 Kişi"/>
                                    <ComboBoxItem Content="4 Kişi"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Buttons -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Vazgeç" Height="40" Background="#1C2433" Foreground="#CBD5E1" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="btnKapat_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" x:Name="btnKaydet" Content="💾 Ayarları Kaydet" Height="40" Background="#FFD026" Foreground="#0F172A" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="btnKaydet_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
