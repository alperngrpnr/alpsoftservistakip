<Page x:Class="alpsoftservistakip.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="RegisterPage" Background="Transparent">

  <Page.RenderTransform>
    <TranslateTransform x:Name="PageTransform" X="0" Y="0"/>
  </Page.RenderTransform>

  <Page.Triggers>
    <EventTrigger RoutedEvent="Page.Loaded">
      <BeginStoryboard>
        <Storyboard Timeline.DesiredFrameRate="60">

          <DoubleAnimation Storyboard.TargetName="PageTransform"
                                     Storyboard.TargetProperty="X"
                                     From="80" To="0" 
                                     Duration="0:0:0.35" 
                                     DecelerationRatio="0.9"/>

          <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" 
                                     Duration="0:0:0.25"/>
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </Page.Triggers>

  <Page.Resources>
    <Style x:Key="DarkInputStyle" TargetType="Control">
      <Setter Property="Background" Value="#252932"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Control">
            <Border x:Name="InputFieldBorder" BorderBrush="#3F4452" BorderThickness="1.5" CornerRadius="8" Background="{TemplateBinding Background}">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="InputFieldBorder" Property="BorderBrush" Value="#FFF5C721"/>
                <Setter TargetName="InputFieldBorder" Property="Background" Value="#1D212A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <StackPanel Margin="45,0,45,0" VerticalAlignment="Center">
    <TextBlock Text="Yeni Şirket Kaydı" Foreground="#FFFFFF" FontSize="24" FontWeight="Bold" Margin="0,0,0,3"/>
    <TextBlock Text="Sisteme dahil olmak için şirket bilgilerinizi girin." Foreground="#6C727F" FontSize="12" Margin="0,0,0,15"/>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="15"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="Ad Soyad" Foreground="#A0A5B1" Margin="3,0,0,4" FontSize="11" FontWeight="SemiBold"/>
        <TextBox x:Name="txtFullName" Style="{StaticResource DarkInputStyle}" Margin="0,0,0,10"/>

        <TextBlock Text="Şirket Adı" Foreground="#A0A5B1" Margin="3,0,0,4" FontSize="11" FontWeight="SemiBold"/>
        <TextBox x:Name="txtCompanyName" Style="{StaticResource DarkInputStyle}" Margin="0,0,0,10"/>

        <TextBlock Text="Şifre" Foreground="#A0A5B1" Margin="3,0,0,4" FontSize="11" FontWeight="SemiBold"/>
        <Grid Margin="0,0,0,10">
            <PasswordBox x:Name="txtPassword" Style="{StaticResource DarkInputStyle}" PasswordChanged="txtPassword_PasswordChanged"/>
            <TextBox x:Name="txtPasswordVisible" Style="{StaticResource DarkInputStyle}" Visibility="Collapsed" TextChanged="txtPasswordVisible_TextChanged"/>
            <Button x:Name="btnTogglePassword1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Background="Transparent" BorderThickness="0" Foreground="#A0A5B1" Cursor="Hand" Click="btnTogglePassword1_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFF5C721"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock x:Name="iconPassword1" Text="&#xE18B;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
            </Button>
        </Grid>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <TextBlock Text="E-posta Adresi" Foreground="#A0A5B1" Margin="3,0,0,4" FontSize="11" FontWeight="SemiBold"/>
        <TextBox x:Name="txtEmail" Style="{StaticResource DarkInputStyle}" Margin="0,0,0,10"/>

        <TextBlock Text="Merkez Şube Adı" Foreground="#A0A5B1" Margin="3,0,0,4" FontSize="11" FontWeight="SemiBold"/>
        <TextBox x:Name="txtBranchName" Style="{StaticResource DarkInputStyle}" Margin="0,0,0,10" Text="Merkez Şube"/>

        <TextBlock Text="Şifre Tekrar" Foreground="#A0A5B1" Margin="3,0,0,4" FontSize="11" FontWeight="SemiBold"/>
        <Grid Margin="0,0,0,10">
            <PasswordBox x:Name="txtPasswordRepeat" Style="{StaticResource DarkInputStyle}" PasswordChanged="txtPasswordRepeat_PasswordChanged"/>
            <TextBox x:Name="txtPasswordRepeatVisible" Style="{StaticResource DarkInputStyle}" Visibility="Collapsed" TextChanged="txtPasswordRepeatVisible_TextChanged"/>
            <Button x:Name="btnTogglePassword2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Background="Transparent" BorderThickness="0" Foreground="#A0A5B1" Cursor="Hand" Click="btnTogglePassword2_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFF5C721"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock x:Name="iconPassword2" Text="&#xE18B;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
            </Button>
        </Grid>
      </StackPanel>
    </Grid>

    <TextBlock Text="Aktivasyon Kodu (Lisans Anahtarı)" Foreground="#A0A5B1" Margin="3,4,0,4" FontSize="11" FontWeight="SemiBold"/>
    <TextBox x:Name="txtActivationCode" MaxLength="17" Style="{StaticResource DarkInputStyle}" Margin="0,0,0,10"/>

    <TextBlock Text="İşletme / Servis Adresi ve Konumu (Opsiyonel)" Foreground="#A0A5B1" Margin="3,4,0,4" FontSize="11" FontWeight="SemiBold"/>
    <TextBox x:Name="txtAddress" Style="{StaticResource DarkInputStyle}" Margin="0,0,0,10" ToolTip="Web randevu sayfasında müşterilerin göreceği dükkan adresi"/>

    <Button x:Name="BtnRegister" Content="ŞİRKETİ KAYDET VE BAŞLA" Background="#FFF5C721" Foreground="#13161C" Height="42" FontWeight="Bold" FontSize="13" Cursor="Hand" Margin="0,10,0,0" Click="BtnRegister_Click">
      <Button.Style>
        <Style TargetType="Button">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="Button">
                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="btnBorder" Property="Background" Value="#FFE0B310"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Button.Style>
    </Button>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
      <TextBlock Text="Zaten hesabın var mı?" Foreground="#6C727F" FontSize="13"/>
      <TextBlock Text="Giriş Yap" Foreground="#FFF5C721" FontSize="13" FontWeight="Bold" Cursor="Hand" PreviewMouseLeftButtonDown="BtnGitGirisYap_Click" Margin="5,0,0,0"/>
    </StackPanel>
  </StackPanel>
</Page>
