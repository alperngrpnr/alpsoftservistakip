<Page x:Class="alpsoftservistakip.PageRandevular"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Online Randevu Yönetimi"
      Background="#0B0F19">

    <Page.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1C2433"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A3447"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#253043"/>
                                <Setter Property="BorderBrush" Value="#FFD026"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#FFD026"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#FFD026"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📅" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Online Randevu Yönetimi" FontSize="22" FontWeight="ExtraBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Web sitenizden müşterilerinizin aldığı randevuları takip edin, tek tıkla servis kaydına dönüştürün." FontSize="13" Foreground="#94A3B8" Margin="34,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="⚙️ Çalışma Saatleri &amp; Ayarlar" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="btnAyarlar_Click"/>
                <Button Content="🌐 Web Linki Kopyala" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="btnLinkKopyala_Click"/>
                <Button Content="🔄 Yenile" Style="{StaticResource PrimaryButtonStyle}" Click="btnYenile_Click"/>
            </StackPanel>
        </Grid>

        <!-- 2. Özet İstatistik Kartları & Filtreler -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- İstatistikler -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Background="#151C2C" BorderBrush="#232F46" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,12,0" MinWidth="130">
                    <StackPanel>
                        <TextBlock Text="BUGÜN" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="txtBugunSayisi" Text="0" FontSize="20" FontWeight="ExtraBold" Foreground="#FFD026" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#151C2C" BorderBrush="#232F46" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,12,0" MinWidth="130">
                    <StackPanel>
                        <TextBlock Text="BEKLEYEN" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="txtBekleyenSayisi" Text="0" FontSize="20" FontWeight="ExtraBold" Foreground="#F59E0B" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#151C2C" BorderBrush="#232F46" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,12,0" MinWidth="130">
                    <StackPanel>
                        <TextBlock Text="ONAYLANAN" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="txtOnaylananSayisi" Text="0" FontSize="20" FontWeight="ExtraBold" Foreground="#10B981" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Filtreler -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="rbBugun" Content="Bugünküler" Foreground="#E2E8F0" FontWeight="SemiBold" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" Cursor="Hand" Checked="Filtre_Changed"/>
                <RadioButton x:Name="rbTumu" Content="Tüm Randevular" Foreground="#E2E8F0" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" Cursor="Hand" Checked="Filtre_Changed"/>
                <DatePicker x:Name="dpTarihSec" Width="130" Height="32" SelectedDateChanged="dpTarihSec_SelectedDateChanged" ToolTip="Özel tarih seç"/>
            </StackPanel>
        </Grid>

        <!-- 3. Randevular Tablosu -->
        <Border Grid.Row="2" Background="#121722" BorderBrush="#202A3C" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
            <DataGrid x:Name="dgRandevular" AutoGenerateColumns="False" CanUserAddRows="False"
                      Background="Transparent" RowBackground="#151C2C" AlternatingRowBackground="#121824"
                      Foreground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1F2839"
                      BorderThickness="0" HeadersVisibility="Column" SelectionMode="Single"
                      RowHeight="46" FontSize="13">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1C2433"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Height" Value="38"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#253043"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <!-- Saat & Tarih -->
                    <DataGridTemplateColumn Header="Randevu Zamanı" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="{Binding RandevuSaati}" FontWeight="ExtraBold" Foreground="#FFD026" FontSize="14"/>
                                    <TextBlock Text="{Binding RandevuTarihi}" Foreground="#94A3B8" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Müşteri -->
                    <DataGridTemplateColumn Header="Müşteri" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="{Binding MusteriAdi}" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding Telefon}" Foreground="#94A3B8" FontSize="11.5"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Cihaz -->
                    <DataGridTemplateColumn Header="Cihaz" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Cihaz}" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="10,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- İşlem / Arıza -->
                    <DataGridTextColumn Header="Talep Edilen İşlem" Binding="{Binding IslemTuru}" Width="160"/>

                    <!-- Notlar -->
                    <DataGridTextColumn Header="Notlar" Binding="{Binding Notlar}" Width="*"/>

                    <!-- Durum Badge -->
                    <DataGridTemplateColumn Header="Durum" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding DurumRenk}" Opacity="0.9" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="{Binding Durum}" Foreground="#0F172A" FontWeight="ExtraBold" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Aksiyonlar -->
                    <DataGridTemplateColumn Header="İşlemler" Width="290">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                    <Button Content="🚀 Servise Çevir" Height="28" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" BorderThickness="0" Padding="8,0" Margin="0,0,6,0" Cursor="Hand" Click="btnServiseCevir_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Height="28" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" BorderThickness="0" Padding="8,0" Margin="0,0,6,0" Cursor="Hand" Click="btnWhatsApp_Click" ToolTip="Müşteriye WhatsApp Mesajı Gönder">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="💬" FontSize="11" Margin="0,0,3,0"/>
                                            <TextBlock Text="WhatsApp" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Height="28" Background="#3B1824" BorderBrush="#EF4444" BorderThickness="1" Padding="8,0" Cursor="Hand" Click="btnIptal_Click" ToolTip="Randevuyu İptal Et">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="✕" Foreground="#EF4444" FontWeight="Bold" FontSize="11" Margin="0,0,3,0"/>
                                            <TextBlock Text="İptal" Foreground="#EF4444" FontWeight="Bold" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
