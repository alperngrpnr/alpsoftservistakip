<Page x:Class="alpsoftservistakip.PageKayitOlustur"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:alpsoftservistakip"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1200"
      Background="#121212">

    <Page.Resources>
        <!-- Dark Theme Colors -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#3498DB"/>
        <SolidColorBrush x:Key="SecondaryDark" Color="#2C3E50"/>
        <SolidColorBrush x:Key="CardBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#27AE60"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F39C12"/>
        <SolidColorBrush x:Key="BorderColor" Color="#333333"/>
        <SolidColorBrush x:Key="TextForeground" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="InputBackground" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="TopHeaderBackground" Color="#1A1A1A"/>
        <LinearGradientBrush x:Key="TitleAccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#06B6D4" Offset="1"/>
        </LinearGradientBrush>

        <!-- TextBox Style Dark -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextForeground}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="border" Property="Background" Value="#383838"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style Dark -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="35"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{TemplateBinding Text}" Padding="{TemplateBinding Padding}" 
                                          VerticalAlignment="Center" Foreground="{StaticResource TextForeground}"/>
                                <!-- Custom simple toggle button -->
                                <ToggleButton Grid.Column="1" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" BorderThickness="0">
                                                <Path Data="M7,10L12,15L17,10H7Z" Fill="{StaticResource TextMuted}" Stretch="Uniform" Width="10" Margin="0,0,5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" 
                                       Focusable="False" PopupAnimation="Slide">
                                    <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border CornerRadius="4" Background="#2D2D2D" BorderThickness="1" BorderBrush="{StaticResource BorderColor}"/>
                                        <ScrollViewer Margin="0,4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{StaticResource TextForeground}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#383838"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Style Dark -->
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,8,15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextForeground}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Label/TextBlock Style Dark -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Section Header Style Dark -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Action Button Style Dark -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Frame Rounded Border -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="Margin" Value="0,0,0,25"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0" Background="{StaticResource TopHeaderBackground}" Padding="30" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="6" Height="54" Background="{StaticResource TitleAccentGradient}" Margin="0,0,20,0" CornerRadius="3"/>
                    <Border Width="42" Height="42" CornerRadius="21" Background="#243447" BorderBrush="#3A5269" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="⚙" FontSize="18" Foreground="#D1E6FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="12" Padding="10,3" HorizontalAlignment="Left" Margin="0,0,0,6">
                            <TextBlock Text="SERVİS YÖNETİM PANELİ" FontSize="10" FontWeight="Bold" Foreground="#93C5FD"/>
                        </Border>
                        <TextBlock Text="YENİ SERVİS KAYDI" FontSize="28" FontWeight="Black" Foreground="White" />
                        <TextBlock Text="Cihaz kabul, takip ve dış servis yönlendirme işlemlerini tek ekrandan yönetin." FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Margin="24,0,0,0" Padding="14,7" CornerRadius="16" Background="#0F1E2E" BorderBrush="#23415F" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock x:Name="txtKayitNo" Text="" FontSize="13" FontWeight="Bold" Foreground="#7DD3FC" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="📋 KOPYALA" Background="#4B5563" Style="{StaticResource ActionButtonStyle}" 
                            Margin="0,0,10,0" Command="{Binding KopyalaCommand}">
                    </Button>

                    <Button Content="🚀 DIŞ SERVİSE GÖNDER" Background="{StaticResource WarningColor}" Style="{StaticResource ActionButtonStyle}" 
                            Margin="0,0,10,0" Command="{Binding DisServiseGonderCommand}">
                    </Button>

                    <Button Content="📄 FİŞ YAZDIR" Background="{StaticResource SuccessColor}" Style="{StaticResource ActionButtonStyle}" 
                            Margin="0,0,10,0" Command="{Binding FisiYazdirCommand}">
                    </Button>

                    <Button Content="💾 KAYDET" Background="{StaticResource PrimaryColor}" Style="{StaticResource ActionButtonStyle}" 
                            Margin="0,0,10,0" Command="{Binding KaydetCommand}">
                    </Button>

                    <Button Content="← GERİ" Background="#374151" Style="{StaticResource ActionButtonStyle}" 
                            Command="{Binding GeriDonCommand}">
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FORM CONTENT -->
        <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Grid MaxWidth="1400" Width="1400" HorizontalAlignment="Stretch" Margin="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- SOL SÜTUN - KART 1: MÜŞTERİ BİLGİLERİ -->
                <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Border CornerRadius="6" Background="#263A4D" Margin="-25,-25,-25,25">
                            <TextBlock Text="MÜŞTERİ BİLGİLERİ" Style="{StaticResource SectionHeaderStyle}" Background="Transparent" Margin="0" Padding="25,15"/>
                        </Border>

                        <StackPanel>
                            <TextBlock Text="Ad Soyadı *"/>
                            <TextBox Text="{Binding AdSoyad, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                            <TextBlock Text="Bayi Adı"/>
                            <ComboBox SelectedItem="{Binding BayiAdi, UpdateSourceTrigger=PropertyChanged}" 
                                     ItemsSource="{Binding BayiListesi}" Margin="0,0,0,15"/>

                            <TextBlock Text="Cep Telefonu *"/>
                            <TextBox Text="{Binding CepTelefonu, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" PreviewTextInput="SayiSadece_PreviewTextInput" TextChanged="Telefon_TextChanged" MaxLength="15" ToolTip="Örn: (5XX) XXX XX XX"/>

                            <TextBlock Text="E-Posta"/>
                            <TextBox Text="{Binding EPosta, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                            <TextBlock Text="Açık Adres"/>
                            <TextBox Text="{Binding Adres, UpdateSourceTrigger=PropertyChanged}" Height="120" 
                                    TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SAĞ SÜTUN - KART 1: CİHAZ BİLGİLERİ -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Border CornerRadius="6" Background="#263A4D" Margin="-25,-25,-25,25">
                            <TextBlock Text="CİHAZ BİLGİLERİ" Style="{StaticResource SectionHeaderStyle}" Background="Transparent" Margin="0" Padding="25,15"/>
                        </Border>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cihaz Türü *"/>
                                <TextBox Text="{Binding CihazTuru, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Marka *"/>
                                <TextBox Text="{Binding Marka, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Model *"/>
                                <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="IMEI / Seri No"/>
                                <TextBox Text="{Binding ImeiNo, UpdateSourceTrigger=PropertyChanged}" MaxLength="15" PreviewTextInput="SayiSadece_PreviewTextInput" ToolTip="15 Haneli IMEI veya Seri No"/>
                            </StackPanel>

                            <Button Grid.Column="2" Content="BTK SORGULA" Background="#374151" 
                                   Style="{StaticResource ActionButtonStyle}" Margin="0,24,0,0" Width="120"
                                   Command="{Binding ImeiSorgulaCommand}"/>
                        </Grid>

                        <StackPanel>
                            <TextBlock Text="Arıza / Şikayet Detayı *"/>
                            <TextBox Text="{Binding SikayetAriza, UpdateSourceTrigger=PropertyChanged}" Height="80" 
                                    TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SAĞ SÜTUN - KART 2: SERVİS VE GARANTİ KONTROLLERİ -->
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Border CornerRadius="6" Background="#263A4D" Margin="-25,-25,-25,25">
                            <TextBlock Text="SERVİS VE GARANTİ DURUMU" Style="{StaticResource SectionHeaderStyle}" Background="Transparent" Margin="0" Padding="25,15"/>
                        </Border>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="İlgili Teknisyen"/>
                                <ComboBox SelectedItem="{Binding IlgiliTeknisyen, UpdateSourceTrigger=PropertyChanged}"
                                         ItemsSource="{Binding TekniksijenListesi}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Servis Durumu"/>
                                <ComboBox SelectedItem="{Binding ServisDurumu, UpdateSourceTrigger=PropertyChanged}">
                                    <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Kabul Edildi</System:String>
                                    <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">İşlemde</System:String>
                                    <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Bitti</System:String>
                                    <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Dış Servis'te</System:String>
                                    <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Tamamlandı</System:String>
                                    <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">İade Edildi</System:String>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cihaz Seçenek" Foreground="{StaticResource TextForeground}" FontWeight="Bold" Margin="0,0,0,10"/>
                                <CheckBox Content="Yeni" IsChecked="{Binding Yeni}"/>
                                <CheckBox Content="Eski" IsChecked="{Binding Eski}"/>
                                <CheckBox Content="Tamir Görmüş" IsChecked="{Binding TamirGormus}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Garanti" Foreground="{StaticResource TextForeground}" FontWeight="Bold" Margin="0,0,0,10"/>
                                <CheckBox Content="Garantili" IsChecked="{Binding Garantili}"/>
                                <CheckBox Content="Garantisiz" IsChecked="{Binding Garantisiz}"/>
                                <CheckBox Content="Servis Garanti" IsChecked="{Binding ServisGarantili}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Diğer" Foreground="{StaticResource TextForeground}" FontWeight="Bold" Margin="0,0,0,10"/>
                                <CheckBox Content="Yedeklensin" IsChecked="{Binding YedeklemeYapilsin}"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- ALT ORTAK ALAN - EK BİLGİLER -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ek Bilgiler (Parola, Aksesuar vb.)"/>
                            <TextBox Text="{Binding EkBilgiler, UpdateSourceTrigger=PropertyChanged}" Height="60" 
                                    TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hesaplanan Fiyat / Ücret Bilgisi (₺)"/>
                            <TextBox Text="{Binding FiyatBilgisi, UpdateSourceTrigger=PropertyChanged}" Height="60" FontSize="20" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Viewbox>
    </Grid>
</Page>
