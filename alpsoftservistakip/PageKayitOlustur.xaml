<Page x:Class="alpsoftservistakip.PageKayitOlustur"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:alpsoftservistakip"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d" 
      d:DesignHeight="950" d:DesignWidth="1280"
      Background="#0D1017">

    <Page.Resources>
        <!-- Color Tokens -->
        <SolidColorBrush x:Key="BgPage" Color="#0D1017"/>
        <SolidColorBrush x:Key="BgCard" Color="#151923"/>
        <SolidColorBrush x:Key="BgCardSub" Color="#1B202D"/>
        <SolidColorBrush x:Key="BgInput" Color="#181D29"/>
        <SolidColorBrush x:Key="BorderNormal" Color="#252D3D"/>
        <SolidColorBrush x:Key="BorderFocus" Color="#FFD026"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#FFD026"/>
        <SolidColorBrush x:Key="PrimaryBlueHover" Color="#FFE0B310"/>

        <!-- TextBox Modern Dark -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderNormal}"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#FFD026"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" 
                                          HorizontalScrollBarVisibility="Hidden" 
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3E4A62"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderFocus}"/>
                                <Setter TargetName="bd" Property="Background" Value="#1C2333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox ve ComboBoxItem stilleri global App.xaml şablonundan miras alınır -->

        <!-- CheckBox Modern Dark -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4,12,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="chkBorder" Width="18" Height="18" CornerRadius="5" 
                                    Background="#181D29" BorderBrush="{StaticResource BorderNormal}" BorderThickness="1.5"
                                    Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path x:Name="chkMark" Data="M3,9 L7,13 L15,4" Stroke="#121418" StrokeThickness="2.2" 
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" Margin="1,-1,0,0" Stretch="Uniform" Width="11" Height="11"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chkBorder" Property="Background" Value="{StaticResource PrimaryBlue}"/>
                                <Setter TargetName="chkBorder" Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
                                <Setter TargetName="chkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chkBorder" Property="BorderBrush" Value="#4B5A77"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label Helper -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Modern Dark DatePicker Style -->
        <Style TargetType="{x:Type DatePicker}">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderNormal}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DatePicker}">
                        <Grid x:Name="PART_Root">
                            <Border x:Name="borderRoot" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <DatePickerTextBox x:Name="PART_TextBox" 
                                                       Grid.Column="0"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       Background="Transparent"
                                                       BorderThickness="0"
                                                       Padding="12,0"
                                                       VerticalContentAlignment="Center"
                                                       Focusable="False"
                                                       IsReadOnly="True">
                                        <DatePickerTextBox.Style>
                                            <Style TargetType="{x:Type DatePickerTextBox}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                                                            <Grid>
                                                                <TextBox x:Name="PART_TextBox"
                                                                         Text="{Binding Path=SelectedDate, RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}, StringFormat='dd.MM.yyyy'}"
                                                                         Background="Transparent"
                                                                         Foreground="#F8FAFC"
                                                                         FontWeight="SemiBold"
                                                                         FontSize="12"
                                                                         BorderThickness="0"
                                                                         VerticalContentAlignment="Center"
                                                                         Padding="0"
                                                                         IsReadOnly="True"/>
                                                                <TextBlock x:Name="PART_Watermark"
                                                                           Text="Tarih Seç..."
                                                                           Foreground="#64748B"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="11"
                                                                           Padding="2,0,0,0"
                                                                           Visibility="Collapsed"/>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Path=SelectedDate, RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}}" Value="{x:Null}">
                                                                    <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </DatePickerTextBox.Style>
                                    </DatePickerTextBox>
                                    <Button x:Name="PART_Button" 
                                            Grid.Column="1"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Width="34"
                                            Cursor="Hand"
                                            Focusable="False">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="Transparent" CornerRadius="0,7,7,0">
                                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="12" 
                                                               Foreground="#FFD026" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#252D3D"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Root}" StaysOpen="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borderRoot" Property="BorderBrush" Value="#3E4A62"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Card Style -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderNormal}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- TOP COMMAND BAR (MODERN & COMPACT)                      -->
        <!-- ======================================================== -->
        <Border Grid.Row="0" Background="#11141C" BorderBrush="{StaticResource BorderNormal}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <!-- Left Title & Actions -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding GeriDonCommand}" Cursor="Hand" Background="#181D29" BorderBrush="{StaticResource BorderNormal}" BorderThickness="1" Margin="0,0,16,0" Padding="12,7">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Geri" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#252D3D"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#3E4A62"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Rectangle Width="1" Height="24" Fill="{StaticResource BorderNormal}" Margin="0,0,16,0"/>

                    <Border Width="28" Height="28" CornerRadius="7" Background="#262112" BorderBrush="#FFD026" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FFD026" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Yeni Servis Kaydı" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <Border Background="#062F22" BorderBrush="#059669" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5" Height="5" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Kabul Modu" FontSize="10" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Kayıt No Badge (Doluysa gösterilir) -->
                    <Border Visibility="{Binding KayitNoBadgeVisibility}" Margin="16,0,0,0" Padding="10,4" CornerRadius="8" Background="#262112" BorderBrush="#FFD026" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FFD026" Margin="0,1,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding KayitBaslik}" FontSize="11" FontWeight="Bold" Foreground="#FFD026" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Kayıt Tarih/Saat Badge -->
                    <Border Margin="10,0,0,0" Padding="10,4" CornerRadius="8" Background="#141824" BorderBrush="#252D3D" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FFD026" Margin="0,1,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding KayitTarihiFormatli}" FontSize="11" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Şube Seçimi / Badge -->
                    <Border Margin="10,0,0,0" Padding="8,3" CornerRadius="8" Background="#141824" BorderBrush="#252D3D" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FFD026" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Şube:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ComboBox Width="130" Height="26"
                                      ItemsSource="{Binding Subeler}"
                                      DisplayMemberPath="BranchName"
                                      SelectedValuePath="BranchId"
                                      SelectedValue="{Binding SeciliSubeId, Mode=TwoWay}"
                                      FontSize="11" FontWeight="SemiBold"
                                      ToolTip="Kayıtlı olduğu şubeyi seçin veya değiştirin"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Kopyala -->
                    <Button Command="{Binding KopyalaCommand}" Margin="0,0,8,0" Cursor="Hand" ToolTip="Kayıt Bilgilerini Kopyala">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#181D29" BorderBrush="{StaticResource BorderNormal}" BorderThickness="1" CornerRadius="8" Padding="12,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE16F;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Kopyala" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#22293A"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#3B465C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Dış Servise Gönder -->
                    <Button Visibility="{Binding DisServisGonderVisibility}" Command="{Binding DisServiseGonderCommand}" Margin="0,0,8,0" Cursor="Hand" ToolTip="Cihazı Dış Servise Sevk Et">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#211A10" BorderBrush="#78350F" BorderThickness="1" CornerRadius="8" Padding="12,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#F59E0B" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Dış Servise Gönder" FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#362410"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#D97706"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Fiş Yazdır -->
                    <Button Visibility="{Binding FisiYazdirVisibility}" Command="{Binding FisiYazdirCommand}" Margin="0,0,10,0" Cursor="Hand" ToolTip="Servis Kabul Fişi Çıkart">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#0C201A" BorderBrush="#065F46" BorderThickness="1" CornerRadius="8" Padding="12,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#10B981" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Fiş Yazdır" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#14342A"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#059669"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Cihaz Etiketi Yazdır -->
                    <Button Visibility="{Binding FisiYazdirVisibility}" Command="{Binding EtiketiYazdirCommand}" Margin="0,0,10,0" Cursor="Hand" ToolTip="Cihaza Yapıştırılacak Termal Etiketi Yazdır">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#252115" BorderBrush="#CA8A04" BorderThickness="1" CornerRadius="8" Padding="12,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FFD026" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Cihaz Etiketi" FontSize="12" FontWeight="SemiBold" Foreground="#FFD026" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#3D3216"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#FACC15"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Müşteriye Bildir (WhatsApp & SMS) -->
                    <Button Command="{Binding MusteriyeBildirCommand}" Margin="0,0,10,0" Cursor="Hand" ToolTip="Müşteriye WhatsApp veya SMS Bildirimi Gönder">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#0F281E" BorderBrush="#16A34A" BorderThickness="1" CornerRadius="8" Padding="12,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#22C55E" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Müşteriye Bildir" FontSize="12" FontWeight="SemiBold" Foreground="#22C55E" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#15422E"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#4ADE80"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Sil -->
                    <Button Visibility="{Binding KayitSilVisibility}" Command="{Binding KayitSilCommand}" Margin="0,0,10,0" Cursor="Hand" ToolTip="Bu Servis Kaydını Sil">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#260C0C" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="8" Padding="12,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#EF4444" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sil" FontSize="12" FontWeight="SemiBold" Foreground="#EF4444" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#3D1515"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#991B1B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Kaydet (Primary) -->
                    <Button Command="{Binding KaydetCommand}" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{StaticResource PrimaryBlue}" CornerRadius="8" Padding="16,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE105;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#121418" Margin="0,1,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Kaydet" FontSize="13" FontWeight="Bold" Foreground="#121418" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryBlueHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- MAIN FORM (RESPONSIVE SCROLLVIEWER)                     -->
        <!-- ======================================================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="1340" Margin="24,20,24,30" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TOP ROW: 2 MAIN COLUMNS -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ========================================== -->
                    <!-- SOL SÜTUN: MÜŞTERİ BİLGİLERİ               -->
                    <!-- ========================================== -->
                    <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <!-- Card Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#262112" BorderBrush="#FFD026" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FFD026" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="MÜŞTERİ BİLGİLERİ" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Müşteri ve bayi iletişim kayıtları" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Kayıt Tarihi ve Saati Düzenleme -->
                            <Border Background="{StaticResource BgCardSub}" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource BorderNormal}" BorderThickness="1" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Tarih -->
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FFD026" Margin="0,1,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Kayıt Tarihi" Style="{StaticResource FieldLabel}" Margin="0"/>
                                        </StackPanel>
                                        <DatePicker SelectedDate="{Binding KayitTarihi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <!-- Saat -->
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FFD026" Margin="0,1,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Saat" Style="{StaticResource FieldLabel}" Margin="0"/>
                                        </StackPanel>
                                        <TextBox Text="{Binding KayitSaati, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 HorizontalContentAlignment="Center" 
                                                 FontWeight="SemiBold"
                                                 MaxLength="5" 
                                                 ToolTip="Kayıt Saati (SS:DD, örn: 14:30)"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Ad Soyad -->
                            <StackPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Adı Soyadı" Style="{StaticResource FieldLabel}" Margin="0"/>
                                    <TextBlock Text=" *" Foreground="#EF4444" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBox Text="{Binding AdSoyad, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Bayi Adı -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Bayi / Kurum" Style="{StaticResource FieldLabel}"/>
                                <ComboBox SelectedItem="{Binding BayiAdi, UpdateSourceTrigger=PropertyChanged}" 
                                          ItemsSource="{Binding BayiListesi}"/>
                            </StackPanel>

                            <!-- Cep Telefonu -->
                            <StackPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Cep Telefonu" Style="{StaticResource FieldLabel}" Margin="0"/>
                                    <TextBlock Text=" *" Foreground="#EF4444" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text=" (5XX) XXX XX XX" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBox Text="{Binding CepTelefonu, UpdateSourceTrigger=PropertyChanged}" 
                                         PreviewTextInput="SayiSadece_PreviewTextInput" 
                                         TextChanged="Telefon_TextChanged" 
                                         MaxLength="16" 
                                         ToolTip="Örn: 0532 123 45 67"/>
                            </StackPanel>

                            <!-- E-Posta -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="E-Posta Adresi" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding EPosta, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Açık Adres -->
                            <StackPanel>
                                <TextBlock Text="Açık Adres" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Adres, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="100" 
                                         TextWrapping="Wrap" 
                                         AcceptsReturn="True" 
                                         VerticalContentAlignment="Top" 
                                         Padding="12,10"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ========================================== -->
                    <!-- SAĞ SÜTUN: CİHAZ VE SERVİS YÖNETİMİ        -->
                    <!-- ========================================== -->
                    <StackPanel Grid.Column="2">
                        <!-- CİHAZ BİLGİLERİ KARTI -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <!-- Header -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#262112" BorderBrush="#FFD026" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FFD026" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="CİHAZ BİLGİLERİ" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Kabul edilen cihazın donanım kimliği" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Tür, Marka, Model 3'lü Grid -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Cihaz Türü -->
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="Cihaz Türü" Style="{StaticResource FieldLabel}" Margin="0"/>
                                            <TextBlock Text=" *" Foreground="#EF4444" FontSize="12" FontWeight="Bold"/>
                                        </StackPanel>
                                        <TextBox Text="{Binding CihazTuru, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <!-- Marka -->
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="Marka" Style="{StaticResource FieldLabel}" Margin="0"/>
                                            <TextBlock Text=" *" Foreground="#EF4444" FontSize="12" FontWeight="Bold"/>
                                        </StackPanel>
                                        <TextBox Text="{Binding Marka, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <!-- Model -->
                                    <StackPanel Grid.Column="4">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="Model" Style="{StaticResource FieldLabel}" Margin="0"/>
                                            <TextBlock Text=" *" Foreground="#EF4444" FontSize="12" FontWeight="Bold"/>
                                        </StackPanel>
                                        <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- IMEI & BTK Sorgula -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="IMEI / Seri Numarası" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding ImeiNo, UpdateSourceTrigger=PropertyChanged}" 
                                                 MaxLength="15" 
                                                 PreviewTextInput="SayiSadece_PreviewTextInput" 
                                                 ToolTip="15 Haneli IMEI veya Seri No"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Command="{Binding ImeiSorgulaCommand}" 
                                            Cursor="Hand" VerticalAlignment="Bottom" Height="40">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FFD026" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="BTK Sorgula" FontSize="12" FontWeight="SemiBold" Foreground="#FFD026" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#2A2210"/>
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#FFD026"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- Arıza Detayı -->
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Arıza / Müşteri Şikayeti" Style="{StaticResource FieldLabel}" Margin="0"/>
                                        <TextBlock Text=" *" Foreground="#EF4444" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBox Text="{Binding SikayetAriza, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="76" 
                                             TextWrapping="Wrap" 
                                             AcceptsReturn="True" 
                                             VerticalContentAlignment="Top" 
                                             Padding="12,10"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- SERVİS & GARANTİ KONTROL KARTI -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <!-- Header -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#064E3B" BorderBrush="#047857" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="SERVİS &amp; GARANTİ KONTROLÜ" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Teknisyen ataması ve durum yönetimi" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Teknisyen & Servis Durumu -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="İlgili Teknisyen" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox SelectedItem="{Binding IlgiliTeknisyen, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding TekniksijenListesi}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Servis Durumu" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox SelectedItem="{Binding ServisDurumu, UpdateSourceTrigger=PropertyChanged}">
                                            <sys:String>Kabul Edildi</sys:String>
                                            <sys:String>İşlemde</sys:String>
                                            <sys:String>Fiyat Teklifi Verildi</sys:String>
                                            <sys:String>Fiyat Onayı Bekliyor</sys:String>
                                            <sys:String>Onaylandı - Tamir Aşamasında</sys:String>
                                            <sys:String>Onaylanmadı - İade Edilecek</sys:String>
                                            <sys:String>Parça Bekliyor</sys:String>
                                            <sys:String>Dış Servis'te</sys:String>
                                            <sys:String>Tamamlandı</sys:String>
                                            <sys:String>Teslim Edildi</sys:String>
                                            <sys:String>İade Edildi</sys:String>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Checkbox Grupları -->
                                <Border Background="{StaticResource BgCardSub}" CornerRadius="8" Padding="14,10" BorderBrush="{StaticResource BorderNormal}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Cihaz Durumu -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Cihaz Durumu" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                            <CheckBox Content="Yeni Cihaz" IsChecked="{Binding Yeni}"/>
                                            <CheckBox Content="Eski Cihaz" IsChecked="{Binding Eski}"/>
                                            <CheckBox Content="Tamir Görmüş" IsChecked="{Binding TamirGormus}"/>
                                        </StackPanel>

                                        <!-- Garanti Durumu -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Garanti Durumu" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                            <CheckBox Content="Garantili" IsChecked="{Binding Garantili}"/>
                                            <CheckBox Content="Garantisiz" IsChecked="{Binding Garantisiz}"/>
                                            <CheckBox Content="Servis Garanti" IsChecked="{Binding ServisGarantili}"/>
                                        </StackPanel>

                                        <!-- Ek Seçenekler -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Özel Talepler" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                            <CheckBox Content="Yedekleme Yapılsın" IsChecked="{Binding YedeklemeYapilsin}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ========================================== -->
                <!-- ALT ROW: EK BİLGİLER VE FİYATLANDIRMA      -->
                <!-- ========================================== -->
                <Border Grid.Row="1" Style="{StaticResource SectionCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ek Bilgiler -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FFD026" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Ek Notlar (Kilit Parolası, Birlikte Alınan Aksesuarlar vb.)" Style="{StaticResource FieldLabel}" Margin="0"/>
                            </StackPanel>
                            <TextBox Text="{Binding EkBilgiler, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="70" 
                                     TextWrapping="Wrap" 
                                     AcceptsReturn="True" 
                                     VerticalContentAlignment="Top" 
                                     Padding="12,8"/>
                        </StackPanel>

                        <!-- ═══════════════════════════════════════════ -->
                        <!-- TOPTANCI & PARÇA BİLGİLERİ KARTI           -->
                        <!-- ═══════════════════════════════════════════ -->
                        <!-- ═══════════════════════════════════════════ -->
                        <!-- TOPTANCI & PARÇA BİLGİLERİ KARTI (ÇOKLU)   -->
                        <!-- ═══════════════════════════════════════════ -->
                        <Border Grid.Column="2" Background="#0E1520" BorderBrush="#2D3A52" BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <DockPanel LastChildFill="True">
                                <!-- 1. Kart Başlığı -->
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="6" Background="#1A2540" BorderBrush="#3B4F78" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#6B9FFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="TOPTANCI &amp; PARÇA MALİYETLERİ" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC"/>
                                            <TextBlock Text="Kullanılan parçaları ekleyin ($ USD)" FontSize="9" Foreground="#64748B"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#1E293B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ParcaListesi.Count, StringFormat={}{0} Parça}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                    </Border>
                                </Grid>

                                <!-- 2. Maliyet & Kar Özeti (Dock: Bottom) -->
                                <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Background="#141A26" BorderBrush="#253248" BorderThickness="1" CornerRadius="6" Padding="8,5"
                                        Visibility="{Binding NetKarGorunurluk}">
                                    <TextBlock Text="{Binding NetKarOzet}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="#34D399"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- 3. Parça Giriş Formu (Dock: Top) -->
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <!-- Üst Satır: Toptancı & Parça Adı -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="1.2*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Toptancı" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                            <ComboBox SelectedItem="{Binding SeciliToptanci, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding ToptanciListesi}"
                                                      DisplayMemberPath="FirmaAdi"
                                                      Background="#181D29"
                                                      BorderBrush="#252D3D"
                                                      Foreground="#F8FAFC"
                                                      Height="28" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Parça Adı" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding ParcaAdi, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="28" FontSize="11"
                                                     ToolTip="Örn: Ekran, Batarya, Kasa"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Alt Satır: Adet, Fiyat ve [+ Parça Ekle] Butonu -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Adet" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding ParcaAdet, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:#}}"
                                                     HorizontalContentAlignment="Center"
                                                     Height="28" FontSize="11"
                                                     PreviewTextInput="SayiSadece_PreviewTextInput"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Birim Fiyat ($)" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding ParcaBirimFiyati, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:#.##}}"
                                                     HorizontalContentAlignment="Right"
                                                     Height="28" FontSize="11"
                                                     ToolTip="USD Dolar birim fiyatı"/>
                                        </StackPanel>
                                        <Button Grid.Column="4" Command="{Binding ParcaEkleCommand}"
                                                Height="28" Margin="0,14,0,0"
                                                Background="#2563EB" Foreground="White" BorderThickness="0"
                                                FontWeight="Bold" FontSize="11" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,4,0"/>
                                                            <TextBlock Text="Parça Ekle" FontSize="10" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- 4. Eklenen Parçalar Listesi (Kalan alanı doldurur) -->
                                <Border Background="#090D14" BorderBrush="#1C2433" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,2,0,0" MinHeight="60">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="100">
                                        <Grid>
                                            <!-- Liste boşken mesaj -->
                                            <TextBlock Text="Henüz parça eklenmedi (opsiyonel)"
                                                       Foreground="#475569" FontSize="10" FontStyle="Italic"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,18,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ParcaListesi.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Parça Listesi -->
                                            <ItemsControl ItemsSource="{Binding ParcaListesi}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#131926" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,3">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ParcaAdi}" FontSize="10" FontWeight="Bold" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding ToptanciAdi}" FontSize="8.5" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding FiyatOzet}" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="6,0"/>
                                                                <Button Grid.Column="2"
                                                                        Command="{Binding DataContext.ParcaSilCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent" BorderThickness="0"
                                                                        Foreground="#EF4444" Cursor="Hand" Width="20" Height="20"
                                                                        ToolTip="Bu parçayı sil">
                                                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </DockPanel>
                        </Border>

                        <!-- ═══════════════════════════════════════════ -->
                        <!-- AYRI AYRI: ÜCRET KARTI & ÖDEME TÜRÜ KARTI  -->
                        <!-- ═══════════════════════════════════════════ -->
                        <Grid Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 1. TAHMİNİ / İŞLEM ÜCRETİ KARTI (ALTIN VURGULU) -->
                            <Border Grid.Row="0" Background="#17140B" BorderBrush="#FFD026" BorderThickness="1.5" CornerRadius="10" Padding="14,10">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#FFD026" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="TAHMİNİ / İŞLEM ÜCRETİ" FontSize="11" FontWeight="Bold" Foreground="#FFD026"/>
                                    </StackPanel>

                                    <TextBox Text="{Binding FiyatBilgisi, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="44" 
                                             FontSize="22" 
                                             FontWeight="Black" 
                                             Foreground="#FFD026"
                                             Background="#110E07"
                                             BorderBrush="#66520B"
                                             HorizontalContentAlignment="Center" 
                                             VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 2. ÖDEME TÜRÜ KARTI (AYRI KART) -->
                            <Border Grid.Row="2" Background="#141824" BorderBrush="#252D3D" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#94A3B8" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="ÖDEME TÜRÜ" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                    </StackPanel>

                                    <ComboBox SelectedItem="{Binding OdemeTuru, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding OdemeTuruListesi}"
                                              Height="40"
                                              Background="#161B26"
                                              BorderBrush="#283347"
                                              Foreground="#F8FAFC"
                                              FontWeight="SemiBold"
                                              HorizontalContentAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
