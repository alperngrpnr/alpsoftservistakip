<Page x:Class="alpsoftservistakip.PageCariDetay"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:alpsoftservistakip"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Background="#0D1017"
      Title="Cari Ekstresi">

    <Page.Resources>
        <!-- Renkler -->
        <SolidColorBrush x:Key="BgPage" Color="#0D1017"/>
        <SolidColorBrush x:Key="BgCard" Color="#151923"/>
        <SolidColorBrush x:Key="BgInput" Color="#181D29"/>
        <SolidColorBrush x:Key="BorderNormal" Color="#252D3D"/>
        <SolidColorBrush x:Key="BorderFocus" Color="#3B82F6"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="RedColor" Color="#EF4444"/>
        <SolidColorBrush x:Key="GreenColor" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#0891B2"/>

        <!-- DatePicker Style Dark -->
        <Style TargetType="{x:Type DatePicker}">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderNormal}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="IsTodayHighlighted" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DatePicker}">
                        <Grid x:Name="PART_Root">
                            <Border x:Name="borderRoot" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <DatePickerTextBox x:Name="PART_TextBox" 
                                                       Grid.Column="0"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       Background="Transparent"
                                                       BorderThickness="0"
                                                       Padding="10,0"
                                                       VerticalContentAlignment="Center"
                                                       Focusable="False"
                                                       IsReadOnly="True">
                                        <DatePickerTextBox.Style>
                                            <Style TargetType="{x:Type DatePickerTextBox}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                                                            <Grid>
                                                                <TextBox x:Name="PART_TextBox"
                                                                         Text="{Binding Path=SelectedDate, RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}, StringFormat='dd.MM.yyyy'}"
                                                                         Background="Transparent"
                                                                         Foreground="{StaticResource TextPrimary}"
                                                                         FontWeight="SemiBold"
                                                                         FontSize="13"
                                                                         BorderThickness="0"
                                                                         VerticalContentAlignment="Center"
                                                                         Padding="0"
                                                                         IsReadOnly="True"/>
                                                                <TextBlock x:Name="PART_Watermark"
                                                                           Text="Tarih Seçin..."
                                                                           Foreground="{StaticResource TextMuted}"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="12"
                                                                           Padding="2,0,0,0"
                                                                           Visibility="Collapsed"/>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Path=SelectedDate, RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}}" Value="{x:Null}">
                                                                    <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </DatePickerTextBox.Style>
                                    </DatePickerTextBox>
                                    
                                    <Button x:Name="PART_Button" 
                                            Grid.Column="1"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Width="34"
                                            Cursor="Hand"
                                            Focusable="False"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Button.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Button.RenderTransform>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="Transparent" CornerRadius="0,7,7,0">
                                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="12" 
                                                               Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#1E293B"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#0F172A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   Placement="Bottom" 
                                   PlacementTarget="{Binding ElementName=PART_Root}" 
                                   StaysOpen="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borderRoot" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="48"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#1F2533"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#11141C"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderNormal}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#171C27"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#222938"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#155E75"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6,2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource BgPage}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Üst Başlık & Eylemler -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" Height="28" Background="{StaticResource AccentCyan}" Margin="0,0,12,0" CornerRadius="2"/>
                    <TextBlock x:Name="txtMusteriAdi" Text="Müşteri Adı - Cari Ekstresi" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Cariyi Sil" Height="38" Click="btnCariSil_Click" Margin="0,0,10,0" Cursor="Hand"
                            Background="#261618" BorderBrush="#7F1D1D" BorderThickness="1" Foreground="#F87171" FontWeight="SemiBold" FontSize="12" Padding="14,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#3B1D20"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="Fiş / Ekstre Yazdır" Height="38" Click="btnFisYazdir_Click" Margin="0,0,10,0" Cursor="Hand"
                            Background="#0C201A" BorderBrush="#065F46" BorderThickness="1" Foreground="#10B981" FontWeight="SemiBold" FontSize="12" Padding="14,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#14342A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Click="btnGeri_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#181D29" BorderBrush="{StaticResource BorderNormal}" BorderThickness="1" CornerRadius="8" Padding="14,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Geri Dön" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#252D3D"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderFocus}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Bakiye Özeti ve Eylem Butonları -->
            <Border Grid.Row="1" Background="{StaticResource BgCard}" CornerRadius="10" Padding="18" Margin="0,0,0,18" BorderBrush="{StaticResource BorderNormal}" BorderThickness="1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="GÜNCEL BAKİYE:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtGuncelBakiye" Text="$0,00" FontSize="22" FontWeight="Black" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#38BDF8"/>
                        <TextBlock x:Name="txtDurum" Text="(...)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Sıfırla" Margin="0,0,10,0" Height="36" Click="btnSifirla_Click" Cursor="Hand"
                                Background="#1E2433" BorderBrush="{StaticResource BorderNormal}" BorderThickness="1" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" FontSize="12" Padding="14,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2A3447"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Content="- Hesabı Borçlandır" Margin="0,0,10,0" Height="36" Click="btnBorclandir_Click" Cursor="Hand"
                                Background="#261618" BorderBrush="#7F1D1D" BorderThickness="1" Foreground="#F87171" FontWeight="Bold" FontSize="12" Padding="14,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#3B1D20"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Content="+ Tahsilat (Ödeme Alındı)" Height="36" Click="btnTahsilat_Click" Cursor="Hand"
                                Background="#0C201A" BorderBrush="#065F46" BorderThickness="1" Foreground="#10B981" FontWeight="Bold" FontSize="12" Padding="14,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#14342A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Hesap Hareketleri Listesi -->
            <Border Grid.Row="2" Background="{StaticResource BgCard}" CornerRadius="10" Padding="16" BorderBrush="{StaticResource BorderNormal}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Modern Tarih Filtreleme Barı -->
                    <Border Grid.Row="0" Background="#11141C" BorderBrush="{StaticResource BorderNormal}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sol Başlık & İkon -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                                <Border Width="30" Height="30" CornerRadius="7" Background="#0C2338" BorderBrush="#1E3A8A" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="HESAP HAREKETLERİ" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Tarih aralığına göre ekstre filtreleyin" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Sağ Tarih Filtreleri & Temizle Butonu -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Başlangıç Kutusu -->
                                <Border Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderNormal}" BorderThickness="1" CornerRadius="8" Height="38" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#1E293B" CornerRadius="7,0,0,7" Padding="10,0" Height="36">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#38BDF8" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Başlangıç" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <DatePicker x:Name="dpBaslangic" Width="135" Height="36" BorderThickness="0" Background="Transparent" SelectedDateChanged="TarihFiltresi_Changed"/>
                                    </StackPanel>
                                </Border>

                                <!-- Bitiş Kutusu -->
                                <Border Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderNormal}" BorderThickness="1" CornerRadius="8" Height="38" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#1E293B" CornerRadius="7,0,0,7" Padding="10,0" Height="36">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#38BDF8" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Bitiş" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <DatePicker x:Name="dpBitis" Width="135" Height="36" BorderThickness="0" Background="Transparent" SelectedDateChanged="TarihFiltresi_Changed"/>
                                    </StackPanel>
                                </Border>

                                <!-- Filtreyi Temizle -->
                                <Button Content="Filtreyi Temizle" Click="btnFiltreTemizle_Click" Height="38" Padding="14,0" 
                                        Background="#261618" BorderBrush="#7F1D1D" BorderThickness="1" Foreground="#F87171" FontWeight="SemiBold" FontSize="12" Cursor="Hand"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Button.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Button.RenderTransform>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#F87171" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Filtreyi Temizle" FontSize="12" FontWeight="SemiBold" Foreground="#F87171" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#3B1D20"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#EF4444"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter TargetName="bd" Property="Background" Value="#1A0D0F"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="dgHareketler" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Seç" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Secili, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Header="Tarih" Binding="{Binding IslemTarihi, StringFormat=dd.MM.yyyy HH:mm}" Width="150" IsReadOnly="True"/>
                            
                            <DataGridTextColumn Header="İşlem Tipi" Binding="{Binding IslemTipi}" Width="140" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IslemTipi}" Value="Borçlandırma">
                                                <Setter Property="Foreground" Value="#F87171"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IslemTipi}" Value="Tahsilat">
                                                <Setter Property="Foreground" Value="#34D399"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTextColumn Header="İşlem Tutarı" Binding="{Binding Tutar, StringFormat=N2}" Width="140" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- YENİ İŞLEM KAYIT POPUP -->
            <Grid x:Name="PanelYeniIslem" Grid.RowSpan="3" Margin="-24" Background="#AA000000" Visibility="Collapsed" Panel.ZIndex="100">
                <Border Background="{StaticResource BgCard}" Width="480" CornerRadius="12" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" BorderBrush="{StaticResource BorderNormal}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="txtPopupBaslik" Text="Yeni İşlem" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                        <TextBlock Text="Tutar ($ / TL)" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                        <Border Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderNormal}" BorderThickness="1" CornerRadius="8" Height="40" Margin="0,0,0,16">
                            <TextBox x:Name="txtIslemTutar" FontSize="15" FontWeight="Bold" Background="Transparent" BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center" Foreground="{StaticResource TextPrimary}" CaretBrush="#38BDF8"/>
                        </Border>

                        <TextBlock Text="Açıklama / Not" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                        <Border Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderNormal}" BorderThickness="1" CornerRadius="8" Height="70" Margin="0,0,0,20">
                            <TextBox x:Name="txtIslemAciklama" TextWrapping="Wrap" AcceptsReturn="True" Background="Transparent" BorderThickness="0" Padding="10,8" VerticalContentAlignment="Top" Foreground="{StaticResource TextPrimary}" CaretBrush="#38BDF8"/>
                        </Border>

                        <Grid>
                            <Button Content="İptal" Width="100" Height="38" HorizontalAlignment="Left" Click="btnPopupIptal_Click"
                                    Background="#181D29" Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource BorderNormal}" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#252D3D"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            
                            <Button x:Name="btnPopupKaydet" Content="İşlemi Kaydet" Width="160" Height="38" HorizontalAlignment="Right" Click="btnPopupKaydet_Click"
                                    Background="#0891B2" Foreground="White" FontWeight="Bold" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#06B6D4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
