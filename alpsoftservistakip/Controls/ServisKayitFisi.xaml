<UserControl x:Class="alpsoftservistakip.Controls.ServisKayitFisi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="792" Height="561"
             Background="White">

    <Grid Background="#FFFFFF" Margin="10">
        <Border CornerRadius="0" Background="White" BorderBrush="#000000" BorderThickness="2">

            <StackPanel Margin="24">
                <!-- Üst Başlık Bölümü -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SERVİS KAYIT FİŞİ" FontSize="26" FontWeight="Black" Foreground="#000000"/>
                        <TextBlock Text="Alpsoft Kurumsal Servis Yönetimi" FontSize="14" Foreground="#000000" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="0" Padding="20,12" BorderBrush="#000000" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding KayitID, StringFormat='KAYIT NO: {0}'}" FontSize="18" FontWeight="ExtraBold" Foreground="#000000" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding KayitTarihi, StringFormat='TARİH: dd.MM.yyyy'}" FontSize="13" FontWeight="SemiBold" Foreground="#000000" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Path Data="M0,0 L1,0" Stretch="Fill" Stroke="#000000" StrokeThickness="1" StrokeDashArray="4,4" Margin="0,0,0,20"/>

                <!-- Müşteri ve Cihaz Bilgileri iki kolon şeklinde tablo gibi -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Müşteri Bilgileri Tablosu -->
                    <Border Grid.Column="0" BorderBrush="#000000" BorderThickness="1" CornerRadius="0">
                        <StackPanel>
                            <Border Background="#F0F0F0" CornerRadius="0" Padding="12,8" BorderBrush="#000000" BorderThickness="0,0,0,1">
                                <TextBlock Text="MÜŞTERİ BİLGİLERİ" Foreground="#000000" FontWeight="Bold" FontSize="13"/>
                            </Border>
                            <Grid Margin="12,12,12,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Müşteri Adı :" Grid.Row="0" Grid.Column="0" Foreground="#000000" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="{Binding IsimSoyisim}" Grid.Row="0" Grid.Column="1" Foreground="#000000" FontWeight="Normal" FontSize="13" TextWrapping="Wrap"/>

                                <TextBlock Text="Telefon :" Grid.Row="2" Grid.Column="0" Foreground="#000000" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="{Binding CepTelefonu}" Grid.Row="2" Grid.Column="1" Foreground="#000000" FontWeight="Normal" FontSize="13"/>

                                <TextBlock Text="Bayi :" Grid.Row="4" Grid.Column="0" Foreground="#000000" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="{Binding BayiAdi}" Grid.Row="4" Grid.Column="1" Foreground="#000000" FontWeight="Normal" FontSize="13" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Cihaz Bilgileri Tablosu -->
                    <Border Grid.Column="2" BorderBrush="#000000" BorderThickness="1" CornerRadius="0">
                        <StackPanel>
                            <Border Background="#F0F0F0" CornerRadius="0" Padding="12,8" BorderBrush="#000000" BorderThickness="0,0,0,1">
                                <TextBlock Text="CİHAZ BİLGİLERİ" Foreground="#000000" FontWeight="Bold" FontSize="13"/>
                            </Border>
                            <Grid Margin="12,12,12,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Marka :" Grid.Row="0" Grid.Column="0" Foreground="#000000" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="{Binding Marka}" Grid.Row="0" Grid.Column="1" Foreground="#000000" FontWeight="Normal" FontSize="13"/>

                                <TextBlock Text="Model :" Grid.Row="2" Grid.Column="0" Foreground="#000000" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="{Binding Model}" Grid.Row="2" Grid.Column="1" Foreground="#000000" FontWeight="Normal" FontSize="13"/>

                                <TextBlock Text="IMEI / Seri :" Grid.Row="4" Grid.Column="0" Foreground="#000000" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="{Binding ImeiNo}" Grid.Row="4" Grid.Column="1" Foreground="#000000" FontWeight="Normal" FontSize="13" FontFamily="Courier New"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Arıza Bilgisi ve Servis Bilgisi Tek Satırda İkiye Bölünmüş -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Arıza Bilgisi -->
                    <Border Grid.Column="0" BorderBrush="#000000" BorderThickness="1" CornerRadius="0">
                        <StackPanel>
                            <Border Background="#F0F0F0" CornerRadius="0" Padding="12,8" BorderBrush="#000000" BorderThickness="0,0,0,1">
                                <TextBlock Text="ARIZA / ŞİKAYET BİLGİSİ" Foreground="#000000" FontWeight="Bold" FontSize="13"/>
                            </Border>
                            <TextBlock Text="{Binding Ariza}" Padding="15" Foreground="#000000" TextWrapping="Wrap" MinHeight="60" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <!-- Servis Bilgisi Tablosu -->
                    <Border Grid.Column="2" BorderBrush="#000000" BorderThickness="1" CornerRadius="0">
                        <StackPanel>
                            <Border Background="#F0F0F0" CornerRadius="0" Padding="12,8" BorderBrush="#000000" BorderThickness="0,0,0,1">
                                <TextBlock Text="SERVİS İŞLEM BİLGİLERİ" Foreground="#000000" FontWeight="Bold" FontSize="13"/>
                            </Border>
                            <Grid Margin="12,12,12,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Durum :" Grid.Row="0" Grid.Column="0" Foreground="#000000" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="{Binding ServisDurumu}" Grid.Row="0" Grid.Column="1" Foreground="#000000" FontWeight="Normal" FontSize="13"/>

                                <TextBlock Text="Teknisyen :" Grid.Row="2" Grid.Column="0" Foreground="#000000" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="{Binding IlgiliTeknisyen}" Grid.Row="2" Grid.Column="1" Foreground="#000000" FontWeight="Normal" FontSize="13"/>

                                <TextBlock Text="Ek Notlar :" Grid.Row="4" Grid.Column="0" Foreground="#000000" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="{Binding EkBilgiler}" Grid.Row="4" Grid.Column="1" Foreground="#000000" TextWrapping="Wrap" FontSize="13"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid VerticalAlignment="Bottom" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" Margin="0,30,0,0">
                        <Border BorderBrush="#000000" BorderThickness="0,1,0,0" Width="200" Margin="0,0,0,5"/>
                        <TextBlock Text="Müşteri İmzası" FontSize="13" Foreground="#000000" TextAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="(Cihazı Teslim Eden)" FontSize="11" Foreground="#000000" TextAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="0,30,0,0">
                        <Border BorderBrush="#000000" BorderThickness="0,1,0,0" Width="200" Margin="0,0,0,5"/>
                        <TextBlock Text="Servis Yetkilisi" FontSize="13" Foreground="#000000" TextAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="(Cihazı Teslim Alan)" FontSize="11" Foreground="#000000" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Sistem Tarafından Oluşturulmuş Resmi Kayıt Fişidir." 
                             FontSize="10" 
                             Foreground="#000000" 
                             TextAlignment="Center"
                             FontStyle="Italic"
                             Margin="0,15,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
